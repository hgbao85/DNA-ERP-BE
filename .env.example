# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/dna_erp?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=http://localhost:3000

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Seed (dev/test only - override in real environments)
SEED_ADMIN_EMAIL=admin@dna-erp.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Bộ giải "Đề xuất thanh sắt" (Phase 7): HiGHS (WASM) chạy trong worker thread NGAY TRONG BE - bộ giải duy
# nhất của ERP, không cần DNA-DEXUAT (changelog 2026-10-20 mục 7.7 và 9).
# SOLVER_TS_WORKERS: số worker song song (1 = một lượt giải tại một thời điểm). SOLVER_TS_HEAP_MB: trần heap
# V8 mỗi worker (0 = mặc định). SOLVER_TS_MAX_RSS_MB: trần RSS toàn tiến trình khi đang giải (0 = tắt) - vượt
# thì chỉ worker chết, API vẫn sống.
SOLVER_TS_WORKERS=1
SOLVER_TS_HEAP_MB=0
SOLVER_TS_MAX_RSS_MB=0
# Trần cho CẢ 1 lần gọi solver (giây): chờ hàng đợi + chạy worker.
SOLVER_TIMEOUT_SECONDS=300

# Realtime (Socket.IO) - để trống = 1 instance, bộ nhớ trong tiến trình.
# Đặt khi chạy nhiều instance BE, ví dụ: REDIS_URL=redis://localhost:6379
REDIS_URL=

# Số lớp proxy/CDN đứng trước app (0 = chạy local, không tin X-Forwarded-For). Production sau Render đặt 1.
# Cần đúng để BE thấy IP thật của client (giới hạn mạng công ty cho công nhân đọc IP này).
TRUST_PROXY_HOPS=0
