# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/dna_erp?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=http://localhost:3000

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Trần chung theo IP (cả nhà máy chung 1 IP) - THROTTLE_LIMIT ở trên đếm theo người
THROTTLE_IP_LIMIT=3000

# Header Server-Timing (total/db/solver) trên mọi response; false = tắt
SERVER_TIMING_ENABLED=true

# Tồn đoạn kho Phôi theo lệnh: true = sau KCS tự ghi đoạn đủ công đoạn vào kho Phôi (giữ cho lệnh, phần vượt vào cột dư).
# Để false cho tới khi phía trừ (Hàn/Sơn trừ phần giữ của lệnh) xong.
SEGMENT_STOCK_ENABLED=false

# Giao nhận giữa tổ (24/11/2026): kho Phôi giao đoạn cho Hàn, kho Hàn giao mảnh cho Sơn bằng phiếu XK; Hàn / Sơn chỉ báo trong số đã
# nhận; Phôi báo cắt chặn ở 102% sắt đã nhận. Cần SEGMENT_STOCK_ENABLED=true. Bật sau khi kiểm kê đoạn.
STAGE_HANDOVER_ENABLED=false

# Pallet Sơn (24/11/2026): pallet cố định có tem QR ở kho Sơn - thủ kho Sơn xếp pallet (lệnh + mảnh + số), công nhân Sơn quét pallet
# báo "Sơn xong", xuất đan quét pallet đã sơn. KCS không đổi. Tắt = như cũ.
PALLET_SON_ENABLED=false

# Chuyền kiểm + Đóng gói bằng quét QR (24/11/2026): công nhân chuyền kiểm quét tem báo số đạt / lỗi (có ảnh), KCS chuyền kiểm chấm
# rồi mới tính "đã qua chuyền kiểm"; công nhân đóng gói quét tem báo số bộ đã đóng (chặn theo số đã qua KCS chuyền kiểm). Tắt = như cũ.
CK_DG_QR_ENABLED=false

# Vị trí kho Thành phẩm (25/11/2026): ô khu-dãy-ô có tem QR; công nhân đóng gói quét ô khi báo (báo đóng gói = cất vào ô); tồn theo
# ô theo bộ SKU - LSX - PO; chuyển ô; soạn hàng theo booking (quét ô khi lấy) vào từng cont; đóng cont cần số cont, seal, ≥ 1 ảnh.
# Xuất theo booking khi bật: số thực xuất = hàng đã đóng cont. Tắt = như cũ.
VI_TRI_KHO_ENABLED=false

# Điều phối đan (25/11/2026): tài khoản Điều phối đan theo dõi điểm đan gia công ngoài - bảng đã gửi / đã trả / còn giữ / hạn trả,
# ghi chú + lời hẹn trả (nhắc khi tới ngày hẹn mà hàng chưa về đủ). Bật thì chỉ Điều phối đan và Admin thêm / sửa / ngừng điểm đan
# (không trùng tên, không ngừng điểm đan còn giữ hàng). Tắt = như cũ (kho Phụ kiện quản lý điểm đan).
DIEU_PHOI_DAN_ENABLED=false

# Logging
LOG_LEVEL=debug

# Seed (dev/test only - override in real environments)
SEED_ADMIN_EMAIL=admin@dna-erp.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Bộ giải "Đề xuất thanh sắt" (Phase 7): HiGHS (WASM) chạy trong worker thread NGAY TRONG BE - bộ giải duy
# nhất của ERP, không cần DNA-DEXUAT (changelog 2026-10-20 mục 7.7 và 9).
# SOLVER_TS_WORKERS: số worker song song (1 = một lượt giải tại một thời điểm). SOLVER_TS_HEAP_MB: trần heap
# V8 mỗi worker (0 = mặc định). SOLVER_TS_MAX_RSS_MB: trần RSS toàn tiến trình khi đang giải (0 = tắt) - vượt
# thì chỉ worker chết, API vẫn sống.
SOLVER_TS_WORKERS=1
SOLVER_TS_HEAP_MB=0
SOLVER_TS_MAX_RSS_MB=0
# Trần cho CẢ 1 lần gọi solver (giây): chờ hàng đợi + chạy worker.
SOLVER_TIMEOUT_SECONDS=300

# Realtime (Socket.IO) - để trống = 1 instance, bộ nhớ trong tiến trình.
# Đặt khi chạy nhiều instance BE, ví dụ: REDIS_URL=redis://localhost:6379
REDIS_URL=

# Số lớp proxy/CDN đứng trước app (0 = chạy local, không tin X-Forwarded-For). Production sau Render đặt 1.
# Cần đúng để BE thấy IP thật của client (giới hạn mạng công ty cho công nhân đọc IP này).
TRUST_PROXY_HOPS=0

# Máy cắt rảnh tự kéo lệnh kế tiếp (đợt C3, Sếp chốt 14/11). Đặt off để tắt (mặc định bật).
CUT_AUTO_PULL=on
