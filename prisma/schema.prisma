generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// MES role a warehouse-scoped user is specialized in. Only meaningful when the user
/// is expected to act on manufacturing-floor resources (see User.mfgRole).
enum MfgRole {
  PRODUCTION_MANAGER
  PHOI
  HAN
  SON
  KCS
  SPEC_STEEL
  SPEC_ACCESSORY
  SPEC_PACKAGING
}

enum NotificationAudience {
  ALL
  BOSS
  WAREHOUSE_STAFF
  /// QLSX - dùng để báo khi 1 CuttingProposal tính xong/thất bại (xem
  /// CuttingProposalsService), vì đây là role sở hữu quyền CUTTING_PROPOSAL.
  PRODUCTION_MANAGER
}

model User {
  id        String    @id @default(uuid())
  /// Login identifier (replaces email as of the username migration - see D.username).
  /// email is kept as a separate contact field, no longer used for authentication.
  username  String    @unique
  email     String    @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Business-attribute columns (not permission columns - see PermissionsGuard/RBAC
  /// above for actual authorization). Used for row-level scoping and MES-specific
  /// guards (@RequireMfgRole/@RequireWarehouseScope) layered on top of PermissionsGuard.
  mfgRole          MfgRole?
  warehouseScope   String?
  isPurchaser      Boolean  @default(false)
  isProductPlanner Boolean  @default(false)
  isSale           Boolean  @default(false)

  roles                             UserRole[]
  refreshTokens                     RefreshToken[]
  notifications                     Notification[]
  notificationReads                 NotificationRead[]
  planForms                         PlanForm[]
  piRequestedItems                  ProductionInvoiceItem[]     @relation("PIItemRequestedBy")
  piQlsxItems                       ProductionInvoiceItem[]     @relation("PIItemQlsxBy")
  piDecidedItems                    ProductionInvoiceItem[]     @relation("PIItemDecidedBy")
  piMerged                          ProductionInvoice[]         @relation("PIMergedBy")
  cuttingProposalsRequested         CuttingProposal[]           @relation("CuttingProposalRequestedBy")
  cuttingProposalsApproved          CuttingProposal[]           @relation("CuttingProposalApprovedBy")
  transferCheckResults              TransferCheckResult[]       @relation("TransferCheckCheckedBy")
  purchaseProposalsApproved         PurchaseProposal[]
  stockLedgerEntries                StockLedger[]
  stockReservations                 StockReservation[]
  materialsToBuy                    Material[]
  steelIssuesIssued                 SteelIssue[]                @relation("SteelIssueIssuedBy")
  qcReviewsReviewed                 QcReview[]                  @relation("QcReviewReviewedBy")
  replenishRequestsFulfilled        ReplenishRequest[]          @relation("ReplenishRequestFulfilledBy")
  weavingIssuesIssued               WeavingIssue[]              @relation("WeavingIssueIssuedBy")
  weavingReceiptsReceived           WeavingReceipt[]            @relation("WeavingReceiptReceivedBy")
  materialIssuesIssued              MaterialIssue[]             @relation("MaterialIssueIssuedBy")
  materialIssuesReceived            MaterialIssue[]             @relation("MaterialIssueReceivedBy")
  productionBatchesReported         ProductionBatch[]           @relation("ProductionBatchReportedBy")
  materialInspectionRequestsCreated MaterialInspectionRequest[]
  inspectionKhoResultsSubmitted     InspectionKhoResult[]
  packagingRecordsPacked            PackagingRecord[]

  @@index([deletedAt])
  @@index([warehouseScope])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Refresh tokens are stored hashed; supports rotation, revocation and logout.
/// The `expiresAt > createdAt` invariant is enforced at the DB level, see prisma/sql/001_add_check_constraints.sql
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  revokedByIp       String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Written by the audit-log Prisma Client Extension (src/prisma/extensions/audit-log.extension.ts)
/// for every create/update/delete on a tracked model.
model AuditLog {
  id            String      @id @default(uuid())
  userId        String?
  action        AuditAction
  tableName     String
  recordId      String
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  correlationId String?
  createdAt     DateTime    @default(now())

  @@index([tableName, recordId])
  @@index([userId])
  @@map("audit_logs")
}

/// Admin broadcast, targeted by audience rather than individual recipients.
/// Per-user read state lives in NotificationRead.
model Notification {
  id        String               @id @default(uuid())
  title     String
  message   String
  audience  NotificationAudience
  createdBy String?
  createdAt DateTime             @default(now())

  creator User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  reads   NotificationRead[]

  @@index([audience])
  @@map("notifications")
}

/// Junction recording which users have read which notification. Composite PK
/// doubles as the upsert target that makes POST /notifications/:id/read idempotent.
model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_reads")
}

/// Singleton row (id is pinned to 1 by a CHECK constraint, see
/// prisma/migrations/.../migration.sql) holding company-wide configuration.
/// Seeded once; there is intentionally no "create" endpoint.
model SystemConfig {
  id              Int     @id @default(1)
  companyName     String
  companyAddress  String?
  companyPhone    String?
  companyEmail    String?
  taxCode         String?
  defaultCurrency String  @default("VND")

  /// Tham số mặc định gọi solver cat_sat_iea (Phase 7 - Đề xuất cắt sắt). Toàn hệ thống dùng
  /// chung 1 bộ, admin sửa qua PUT /system-config - KHÔNG có màn nào cho nhập tay mỗi lần vì
  /// trigger tính đề xuất chạy tự động/ngầm khi Sếp duyệt lệnh sản xuất (không qua form).
  /// solverStockLengths: các chiều dài thanh sắt nguyên chuẩn (mm) - CHỈ điền chiều dài NCC
  /// THỰC SỰ CÓ SẴN HÀNG. Solver chọn phương án cắt tối ưu trong đúng danh sách này, và đề xuất
  /// mua KHÔNG mang theo chiều dài (purchase_proposal_items chỉ có materialId + buyQty) nên
  /// không ai phát hiện được nếu ở đây lỡ điền cỡ không mua được: Mua hàng vẫn mua cỡ chuẩn,
  /// còn bảng hướng dẫn cắt của Phôi lại tính theo cỡ không có thật. Bỏ 5850 (2026-08-12): đã
  /// hỏi lại NCC, hiện chỉ cung cấp 6000mm.
  solverStockLengths       Json  @default("[6000]")
  solverTrimStartMm        Int   @default(10)
  solverBladeWidthMm       Float @default(1.0)
  /// Ngưỡng hao hụt cắt MẶC ĐỊNH, áp cho vật tư Sắt chưa được cấp ngưỡng riêng (xem
  /// Material.maxCuttingWastePercentage - field đó ghi đè giá trị này cho đúng vật tư).
  solverMaxWastePercentage Float @default(1.0)
  solverMaxSurplus         Int   @default(10)
  solverMinLengthMm        Int   @default(5000)
  solverMaxLengthMm        Int   @default(6000)
  solverLengthStepMm       Int   @default(10)
  /// time_limit_seconds GỬI CHO solver mỗi lần giải - KHÔNG phải timeout HTTP client (xem
  /// SOLVER_TIMEOUT_SECONDS trong env). Số lần giải = số loại sắt x (1 + N lần vét cạn), có
  /// thể lên tới hàng trăm lần - để thấp (docs/PHAN_TICH_HE_THONG_CatSat.md khuyến nghị 8-30s
  /// cho production), KHÔNG dùng default 480s của chính solver.
  solverTimeLimitSeconds   Int   @default(20)

  /// Dung sai giao THỪA cho phép khi Thủ kho nhận hàng mua về, tính theo % của buyQty (xem
  /// PurchaseProposalsService.receiveItem). Trong dung sai -> ghi ĐÚNG số thực nhận, kể cả khi
  /// vượt buyQty; vượt dung sai -> chặn và báo lỗi nêu rõ 3 số. Mặc định 0 = không cho nhận thừa.
  /// Trước 2026-08-15 code cắt âm thầm bằng Math.min(buyQty, ...): NCC giao 12 trên đơn 10 thì sổ
  /// ghi 10, hai cây kia biến mất khỏi sổ nhưng vẫn nằm trong kho thật - không cảnh báo, không
  /// log, tồn hệ thống lệch tồn thực ngay từ lúc nhập (D.b3-silent-over-receipt).
  purchaseOverReceiptTolerancePercent Float @default(0)

  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// =====================================================================
// Phase 2 — Danh mục / Master Data + BOM Revision
// Nguồn: docs/dna-erp-db-schema.html mục 1.2. Domain này (và mọi domain
// sau) dùng bigserial/bigint làm PK thay vì UUID của Auth/Core — quyết
// định D0.1 (UUID) chỉ áp cho phần Auth/Core đã triển khai ở P0, không
// mở rộng sang đây; đây là tách bạch có chủ đích theo đúng schema doc,
// không phải sự không nhất quán.
// =====================================================================

enum MfgStage {
  PHOI
  HAN
  SON
  /// Xuất đan — Dây/Đinh gộp cùng khung chưa đan tại kho vật tư thành phẩm, đưa tới điểm đan.
  DAN
}

enum BomRevisionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model MaterialGroup {
  id   BigInt @id @default(autoincrement())
  name String @unique

  /// Khoá kỹ thuật cố định cho 6 nhóm hệ thống (seed sẵn ở prisma/seed.ts: STEEL_BAR/WIRE/
  /// NAIL/RIVET/PLASTIC_BUTTON/OTHER). Sơn/Phụ kiện/Bao bì đều dùng chung nhóm OTHER ("Vật
  /// tư khác") - phân biệt Sơn (qua ConsumableBom.stage=SON) và Phụ kiện/Bao bì (qua
  /// BomAccessoryItem.kind) không còn dựa vào nhóm vật tư nữa. Mọi logic nghiệp vụ (4 trang
  /// Spec, validate BOM) match theo cột này, KHÔNG theo `name` - admin đổi tên nhóm thoải
  /// mái mà không làm hỏng lọc. Nhóm do admin tự tạo thêm = null, vô hình với logic Spec.
  systemKey String? @unique

  /// Tiền tố mã vật tư tự sinh khi tạo Material không nhập `code` (vd 'SAT' -> 'SAT-001',
  /// 'SAT-002'...) - MaterialsService.resolveCodePrefix() đọc thẳng cột này, KHÔNG suy từ
  /// `name` (2 nhóm tên khác nhau vẫn có thể trùng đoạn đầu, vd "Ống nhựa PVC" và "Ống nhôm"
  /// đều ra "ONG" nếu suy từ tên - unique ở đây triệt tiêu hẳn rủi ro đó). 6 nhóm hệ thống
  /// seed sẵn giá trị cố định (material-group-code-prefix.constant.ts); nhóm admin tự tạo
  /// bắt buộc nhập lúc tạo (CreateMaterialGroupDto) - FE gợi ý sẵn từ tên, admin sửa được.
  codePrefix String @unique

  materials Material[]

  @@map("material_groups")
}

enum MaterialDetailKind {
  PAINT
  ACCESSORY
  PACKAGING
}

model Material {
  id                        BigInt              @id @default(autoincrement())
  code                      String              @unique
  name                      String
  unit                      String
  spec                      String?
  materialGroupId           BigInt?
  /// Sơn/Phụ kiện/Bao bì (chỉ có ý nghĩa khi materialGroup.systemKey = OTHER "Vật tư khác" -
  /// null với mọi nhóm khác) - dùng để lọc riêng từng tab trên trang Định mức chi tiết
  /// (SpecDetailQuotaPage.tsx), vì 3 tab đó giờ dùng CHUNG 1 nhóm vật tư nên không còn phân
  /// biệt được qua materialGroupId nữa. Bắt buộc chọn ở Admin > Vật tư khi nhóm = Vật tư khác
  /// (MaterialsService.resolveDetailKind), tự dọn về null khi đổi sang nhóm khác.
  detailKind                MaterialDetailKind?
  warehouseId               BigInt?
  buyerId                   String?
  /// Đơn vị mua hàng từ NCC khi khác với `unit` (đơn vị tồn kho/sản xuất) - vd NCC bán theo "kg"
  /// nhưng sản xuất dùng "cái". Để trống nếu vật tư chỉ có 1 đơn vị duy nhất (unit).
  purchaseUnit              String?
  /// Hệ số quy đổi: số lượng `unit` tương ứng với 1 `purchaseUnit` (vd 250 = 250 cái/kg).
  /// Chỉ có ý nghĩa khi purchaseUnit khác null.
  khoUnitFactor             Decimal?            @db.Decimal(14, 4)
  /// % hao hụt Sếp cấp riêng cho vật tư này - CHỈ có ý nghĩa khi materialGroup.systemKey =
  /// STEEL_BAR (null với mọi nhóm khác, xem MaterialsService.resolveWasteFields - mirror
  /// resolveDetailKind ở trên). Đây là NGƯỠNG hao hụt tối đa chấp nhận được khi cắt (không
  /// phải số đo), gửi xuống solver cắt sắt (CuttingProposalsService.runSolverAndSave) làm
  /// max_waste_percentage riêng cho vật tư này, ghi đè SystemConfig.solverMaxWastePercentage
  /// (vẫn là mặc định khi để trống). Đặt quá thấp có thể khiến solver KHÔNG tìm được phương án
  /// cắt nào (vô nghiệm), không phải chỉ là "cảnh báo" - xem comment ở nơi gọi.
  maxCuttingWastePercentage Decimal?            @db.Decimal(6, 3)
  /// % dự trù hao hụt khi MUA vật tư này (vd bao bì rách/lỗi lúc vận chuyển) - CHỈ có ý nghĩa
  /// khi materialGroup.systemKey KHÁC STEEL_BAR (null với Sắt, xem
  /// MaterialsService.resolveWasteFields). Khác hẳn maxCuttingWastePercentage ở trên: đây là
  /// ĐỆM cộng thêm vào số lượng đề xuất mua (SL cần mua thực = SL đề xuất mua gốc + % này),
  /// không phải ràng buộc. Field sẵn sàng nhưng CHƯA nối vào luồng đề xuất mua nào (luồng đó
  /// hiện chỉ tồn tại cho Sắt, xem cutting-proposals.service.ts) - chờ xây khi có luồng cho
  /// vật tư khác.
  purchaseWastePercentage   Decimal?            @db.Decimal(6, 3)
  imageUrl                  String?
  isActive                  Boolean             @default(true)
  deletedAt                 DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  materialGroup                 MaterialGroup?                 @relation(fields: [materialGroupId], references: [id])
  warehouse                     Warehouse?                     @relation(fields: [warehouseId], references: [id])
  buyer                         User?                          @relation(fields: [buyerId], references: [id])
  materialSuppliers             MaterialSupplier[]
  segmentSpecs                  SegmentSpec[]
  consumableBoms                ConsumableBom[]
  bomAccessoryItems             BomAccessoryItem[]
  cuttingProposalLines          CuttingProposalLine[]
  purchaseProposalItems         PurchaseProposalItem[]
  stockLedgerEntries            StockLedger[]
  stockQuants                   StockQuant[]
  warehouseTransferItems        WarehouseTransferItem[]
  warehouseTransferReservations WarehouseTransferReservation[]
  stockReservations             StockReservation[]
  pieceMaterialItems            PieceMaterialItem[]
  steelIssues                   SteelIssue[]
  materialIssues                MaterialIssue[]
  inspectionKhoResultItems      InspectionKhoResultItem[]

  @@index([materialGroupId])
  @@index([warehouseId])
  @@index([buyerId])
  @@map("materials")
}

model Supplier {
  id        BigInt    @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  materialSuppliers      MaterialSupplier[]
  purchaseProposalQuotes PurchaseProposalQuote[]

  @@map("suppliers")
}

/// Junction vật tư <-> NCC, kèm giá. UQ (materialId, supplierId) theo doc.
model MaterialSupplier {
  id           BigInt  @id @default(autoincrement())
  materialId   BigInt
  supplierId   BigInt
  price        Decimal @db.Decimal(14, 2)
  leadTimeDays Int?

  material Material @relation(fields: [materialId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([materialId, supplierId])
  @@map("material_suppliers")
}

model DefectReason {
  id        BigInt    @id @default(autoincrement())
  label     String
  stageType MfgStage?

  qcReviews QcReview[]

  @@index([stageType])
  @@map("defect_reasons")
}

model WeavingPoint {
  id              BigInt    @id @default(autoincrement())
  code            String    @unique
  fullName        String?
  aliasNote       String?
  phone           String?
  address         String?
  dayDaiPercent   Decimal?  @db.Decimal(5, 2)
  ketThucPercent  Decimal?  @db.Decimal(5, 2)
  hangQuanPercent Decimal?  @db.Decimal(5, 2)
  note            String?
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  weavingIssues   WeavingIssue[]
  weavingReceipts WeavingReceipt[]

  @@map("weaving_points")
}

/// 6 kho vật lý + 3 kho ảo (SUPPLIER/PRODUCTION/SCRAP) — seed cố định, xem prisma/seed.ts.
/// Không có endpoint DELETE cho các code trong PROTECTED_WAREHOUSE_CODES
/// (src/common/constants/protected-warehouse-codes.constant.ts).
model Warehouse {
  id        BigInt    @id @default(autoincrement())
  code      String    @unique
  name      String
  isVirtual Boolean   @default(false)
  note      String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  fromStockLedgerEntries        StockLedger[]                  @relation("StockLedgerFromWarehouse")
  toStockLedgerEntries          StockLedger[]                  @relation("StockLedgerToWarehouse")
  stockQuants                   StockQuant[]
  fromWarehouseTransfers        WarehouseTransfer[]            @relation("WarehouseTransferFromWarehouse")
  toWarehouseTransfers          WarehouseTransfer[]            @relation("WarehouseTransferToWarehouse")
  warehouseTransferReservations WarehouseTransferReservation[]
  stockReservations             StockReservation[]
  materials                     Material[]

  @@map("warehouses")
}

/// Khách hàng dùng chung nội địa lẫn xuất khẩu (hợp nhất với mfg_export_customers cũ).
model Customer {
  id          BigInt   @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  country     String?
  market      String?
  contactName String?
  note        String?
  createdAt   DateTime @default(now())

  productVariants ProductVariant[]
  salesOrders     SalesOrder[]

  @@map("sales_customers")
}

model MfgProduct {
  id          BigInt  @id @default(autoincrement())
  factoryCode String  @unique
  name        String
  description String?

  variants               ProductVariant[]
  pieces                 Piece[]
  parts                  Part[]
  bomRevisions           BomRevision[]
  salesOrderItems        SalesOrderItem[]
  planForms              PlanForm[]
  productionInvoiceItems ProductionInvoiceItem[]
  productionOrders       ProductionOrder[]

  @@map("mfg_products")
}

model ProductVariant {
  id           BigInt    @id @default(autoincrement())
  mfgProductId BigInt
  customerId   BigInt?
  colorCode    String?
  description  String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  mfgProduct             MfgProduct              @relation(fields: [mfgProductId], references: [id])
  customer               Customer?               @relation(fields: [customerId], references: [id])
  packagingBoms          PackagingBom[]
  productionInvoiceItems ProductionInvoiceItem[]
  stockLedgerEntries     StockLedger[]
  stockQuants            StockQuant[]

  @@index([mfgProductId])
  @@index([customerId])
  @@map("product_variants")
}

/// Mảnh khung — đơn vị BOM cắt bên Phôi. Chỉ là định danh; số lượng/SKU nằm ở bom_piece
/// theo từng bom_revision (không versioning được nếu để trên master, đây là bài học từ
/// frame_pieces cũ).
model Piece {
  id           BigInt   @id @default(autoincrement())
  mfgProductId BigInt
  code         String
  groupNumber  Int
  pieceNumber  Int?
  name         String
  isWoven      Boolean  @default(false)
  weavingPrice Decimal? @db.Decimal(14, 2)

  mfgProduct                  MfgProduct                   @relation(fields: [mfgProductId], references: [id])
  bomPieces                   BomPiece[]
  pieceBoms                   PieceBom[]
  pieceMaterialItems          PieceMaterialItem[]
  stockLedgerEntries          StockLedger[]
  stockQuants                 StockQuant[]
  transferCheckResults        TransferCheckResult[]
  weavingIssues               WeavingIssue[]
  weavingReceipts             WeavingReceipt[]
  productionBatches           ProductionBatch[]
  warehouseTransferPieceItems WarehouseTransferPieceItem[]

  @@unique([mfgProductId, code])
  @@index([mfgProductId])
  @@map("piece")
}

/// KHÔNG còn dùng cho báo sản lượng Hàn/Sơn (đã dời sang Piece - xem ProductionBatch.piece) vì
/// Hàn -> Sơn -> Đan đều làm việc theo mảnh (Piece), chỉ Phôi làm theo từng thanh sắt cấu thành
/// mảnh. Giữ lại model + CRUD (bom-revisions.controller.ts) vì chưa có UI/luồng nào thật sự dùng
/// tới (bomParts/partBoms luôn rỗng trong thực tế) - không phải đang được tham chiếu ở đâu khác.
model Part {
  id           BigInt @id @default(autoincrement())
  mfgProductId BigInt
  code         String
  name         String

  mfgProduct MfgProduct @relation(fields: [mfgProductId], references: [id])
  bomParts   BomPart[]
  partBoms   PartBom[]

  @@unique([mfgProductId, code])
  @@map("part")
}

/// Đoạn sắt = material (phải thuộc nhóm vật tư Sắt - materialGroup.systemKey=STEEL_BAR,
/// ràng buộc ở tầng service) + chiều dài cắt.
model SegmentSpec {
  id          BigInt @id @default(autoincrement())
  materialId  BigInt
  cutLengthMm Int

  material                       Material                        @relation(fields: [materialId], references: [id])
  pieceBoms                      PieceBom[]
  partBoms                       PartBom[]
  cuttingProposalPatternSegments CuttingProposalPatternSegment[]
  stockLedgerEntries             StockLedger[]
  stockQuants                    StockQuant[]
  cutPatternSegments             CutPatternSegment[]

  @@unique([materialId, cutLengthMm])
  @@map("segment_spec")
}

/// Phiên bản định mức theo sản phẩm. production_order (P7) ghim đúng 1 bomRevisionId tại
/// thời điểm tạo. sourcePlanFormId nay đã có FK thật tới plan_forms (bảng này được dựng
/// cùng domain Sales/Production Order — xem plan_forms bên dưới); trước đó chỉ là cột trace.
model BomRevision {
  id               BigInt            @id @default(autoincrement())
  mfgProductId     BigInt
  revNo            Int
  status           BomRevisionStatus @default(DRAFT)
  /// @unique: 1 PlanForm chỉ sở hữu đúng 1 BomRevision (tạo lười ở lần ghi định mức đầu
  /// tiên) - chặn race condition tạo trùng khi 2 request ghi gần như đồng thời cùng thấy
  /// "chưa có revision" (xem PlanFormsService.resolveDraftBomRevision).
  sourcePlanFormId BigInt?           @unique
  createdAt        DateTime          @default(now())

  mfgProduct         MfgProduct          @relation(fields: [mfgProductId], references: [id])
  sourcePlanForm     PlanForm?           @relation(fields: [sourcePlanFormId], references: [id])
  bomPieces          BomPiece[]
  bomParts           BomPart[]
  pieceBoms          PieceBom[]
  partBoms           PartBom[]
  pieceMaterialItems PieceMaterialItem[]
  consumableBoms     ConsumableBom[]
  bomAccessoryItems  BomAccessoryItem[]
  productionOrders   ProductionOrder[]

  @@unique([mfgProductId, revNo])
  /// Composite-unique target cho FK ghép của piece_bom/part_bom (xem PieceBom/PartBom) -
  /// cho phép Postgres tự chặn 1 dòng piece_bom/part_bom trỏ nhầm sang bom_revision của
  /// mfg_product khác với piece/part của chính dòng đó, đúng yêu cầu "ràng buộc chéo cha"
  /// trong dna-erp-db-schema.html mục piece_bom.
  @@unique([id, mfgProductId])
  @@map("bom_revision")
}

/// SL mảnh/SKU theo revision.
model BomPiece {
  id            BigInt  @id @default(autoincrement())
  bomRevisionId BigInt
  pieceId       BigInt
  qtyPerUnit    Int
  /// Snapshot "mảnh có đan" (đủ Dây+Đinh+Nút nhựa) TẠI THỜI ĐIỂM revision này được lưu - xem
  /// SkusService.replacePieces. KHÔNG đọc piece.isWoven (global, dùng chung tên piece giữa các
  /// revision) để tránh 1 SKU khác sửa lại định mức cùng tên mảnh làm rớt/hiện nhầm mảnh của
  /// production order đang chạy dở (xem trao đổi nghiệp vụ) - mỗi order tự đứng độc lập theo
  /// đúng snapshot của bomRevisionId nó gắn.
  isWoven       Boolean @default(false)
  /// Mảnh này có cần routing sang Hàn/Sơn không - áp dụng cho CẢ mảnh (không phải từng thanh
  /// sắt riêng lẻ, xem PieceBom cũ trước khi dời field này lên đây).
  needsHan      Boolean @default(false)
  needsSon      Boolean @default(false)

  bomRevision BomRevision @relation(fields: [bomRevisionId], references: [id])
  piece       Piece       @relation(fields: [pieceId], references: [id])

  @@unique([bomRevisionId, pieceId])
  @@map("bom_piece")
}

/// SL chi tiết/SKU theo revision.
model BomPart {
  id            BigInt @id @default(autoincrement())
  bomRevisionId BigInt
  partId        BigInt
  qtyPerUnit    Int

  bomRevision BomRevision @relation(fields: [bomRevisionId], references: [id])
  part        Part        @relation(fields: [partId], references: [id])

  @@unique([bomRevisionId, partId])
  @@map("bom_part")
}

/// Công đoạn phôi chi tiết cho 1 đoạn sắt (PieceBom) - 1 thanh sắt có thể trải qua nhiều công
/// đoạn cùng lúc (vd vừa tán vừa dập), nên lưu dạng mảng thay vì 1 giá trị đơn.
enum ProcessStep {
  CAT
  UON
  DAP
  /// Đục lỗ
  DUC_LO
  TAN
  /// Tóp đầu
  TOP_DAU
  /// Xẻ
  XE
}

/// Đoạn cấu thành 1 mảnh. mfgProductId denormalized để FK ghép (bomRevisionId,
/// mfgProductId) -> BomRevision(id, mfgProductId): tầng service khi insert phải set
/// mfgProductId = piece.mfgProductId, DB sẽ tự chặn nếu revision đó thuộc product khác.
model PieceBom {
  id            BigInt        @id @default(autoincrement())
  bomRevisionId BigInt
  mfgProductId  BigInt
  pieceId       BigInt
  segmentSpecId BigInt
  qtyPerPiece   Int
  /// Công đoạn phôi chi tiết của thanh sắt này (cắt/uốn/dập/đục lỗ/tán) - đa chọn, có thể rỗng.
  processSteps  ProcessStep[] @default([])
  /// Ghi chú riêng cho dòng loại sắt này (vd "mạ kẽm", "cắt vát 45°") - KHSX xem trực tiếp ở
  /// cột Loại sắt khi duyệt định mức mảnh.
  note          String?

  bomRevision BomRevision @relation(fields: [bomRevisionId, mfgProductId], references: [id, mfgProductId])
  piece       Piece       @relation(fields: [pieceId], references: [id])
  segmentSpec SegmentSpec @relation(fields: [segmentSpecId], references: [id])

  @@unique([bomRevisionId, pieceId, segmentSpecId])
  @@map("piece_bom")
}

/// Vật tư phẳng cấu thành 1 mảnh (Dây/Đinh/Tán rút/Nút nhựa) - KHÔNG dùng PieceBom/SegmentSpec
/// (khái niệm đó là "đoạn cắt", chỉ đúng cho Sắt; cutting-proposals đọc toàn bộ PieceBom không
/// lọc nhóm vật tư nên không được lẫn Dây/Đinh vào đó, xem cutting-proposals.service.ts
/// buildBomRows). Nhóm cụ thể (Dây/Đinh/Tán rút/Nút nhựa) suy ra từ material.materialGroup
/// (systemKey WIRE/NAIL/RIVET/PLASTIC_BUTTON) khi đọc lại, không lưu cột group riêng - cùng
/// pattern ConsumableBom. Cùng kiểu FK ghép mfgProductId như PieceBom.
model PieceMaterialItem {
  id            BigInt  @id @default(autoincrement())
  bomRevisionId BigInt
  mfgProductId  BigInt
  pieceId       BigInt
  materialId    BigInt
  qtyPerPiece   Decimal @db.Decimal(14, 4)
  note          String?

  bomRevision BomRevision @relation(fields: [bomRevisionId, mfgProductId], references: [id, mfgProductId])
  piece       Piece       @relation(fields: [pieceId], references: [id])
  material    Material    @relation(fields: [materialId], references: [id])

  @@unique([bomRevisionId, pieceId, materialId])
  @@map("piece_material_item")
}

/// Đoạn cấu thành 1 chi tiết hàn. Cùng kiểu FK ghép mfgProductId như PieceBom — doc gốc
/// chỉ nêu rõ yêu cầu này cho piece_bom, áp dụng thêm cho part_bom ở đây cho nhất quán vì
/// cùng lớp rủi ro toàn vẹn dữ liệu (part thuộc sai mfg_product).
model PartBom {
  id            BigInt @id @default(autoincrement())
  bomRevisionId BigInt
  mfgProductId  BigInt
  partId        BigInt
  segmentSpecId BigInt
  qtyPerPart    Int

  bomRevision BomRevision @relation(fields: [bomRevisionId, mfgProductId], references: [id, mfgProductId])
  part        Part        @relation(fields: [partId], references: [id])
  segmentSpec SegmentSpec @relation(fields: [segmentSpecId], references: [id])

  @@unique([bomRevisionId, partId, segmentSpecId])
  @@map("part_bom")
}

/// Định mức vật tư tiêu hao theo revision, gắn với 1 công đoạn cụ thể (Phôi/Hàn/Sơn/Đan -
/// vd Dây/Đinh dùng ở Đan, Sơn dùng ở Sơn). Phân biệt Dây/Đinh (cùng stage=DAN) qua
/// material.materialGroup.systemKey (WIRE/NAIL); Sơn xác định thẳng qua stage=SON - không
/// nhóm vật tư nào khác dùng stage này nên không cần lọc thêm theo nhóm. Phụ kiện/Bao bì
/// KHÔNG gắn công đoạn nên dùng bảng riêng BomAccessoryItem, không phải bảng này.
model ConsumableBom {
  id            BigInt   @id @default(autoincrement())
  bomRevisionId BigInt
  stage         MfgStage
  materialId    BigInt
  qtyPerUnit    Decimal  @db.Decimal(14, 4)

  bomRevision BomRevision @relation(fields: [bomRevisionId], references: [id])
  material    Material    @relation(fields: [materialId], references: [id])

  @@unique([bomRevisionId, stage, materialId])
  @@map("consumable_bom")
}

/// Phụ kiện/Bao bì tiêu hao theo revision - không gắn công đoạn sản xuất (khác
/// ConsumableBom). Sơn/Phụ kiện/Bao bì đều dùng chung 1 nhóm vật tư hệ thống ("Vật tư khác",
/// systemKey OTHER) nên KHÔNG còn phân biệt Phụ kiện vs Bao bì qua nhóm vật tư được nữa -
/// cột `kind` dưới đây lưu trực tiếp đó là dòng nào. KHÔNG tái dùng PackagingBom - model đó
/// gắn ProductVariant (theo màu), không có vòng đời DRAFT/ACTIVE, sai phạm vi.
model BomAccessoryItem {
  id            BigInt            @id @default(autoincrement())
  bomRevisionId BigInt
  materialId    BigInt
  kind          AccessoryItemKind
  qtyPerUnit    Decimal           @db.Decimal(14, 4)

  bomRevision BomRevision @relation(fields: [bomRevisionId], references: [id])
  material    Material    @relation(fields: [materialId], references: [id])

  @@unique([bomRevisionId, materialId])
  @@map("bom_accessory_items")
}

enum AccessoryItemKind {
  ACCESSORY
  PACKAGING
}

/// BOM đóng gói theo biến thể sản phẩm.
model PackagingBom {
  id               BigInt  @id @default(autoincrement())
  productVariantId BigInt
  itemName         String
  unit             String
  qtyPerSet        Decimal @db.Decimal(14, 4)
  isActive         Boolean @default(true)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([productVariantId])
  @@map("packaging_bom")
}

// =====================================================================
// Sales Order + Production Order — dịch ngược từ mock FE (SalesPO + PlanForm +
// ProductionInvoice). Hợp nhất 2 khái niệm "PO" đang trùng lặp/lệch nhau trong mock
// (salesPOs của Sales module và exportOrders của Mfg module, chỉ khớp nhau qua so sánh
// chuỗi poNumber/code, không FK thật) thành 1 bảng sales_orders duy nhất.
//
// Phạm vi cố ý KHÔNG bao gồm ở domain này (để dành phase sau, xem docs/CONTRIBUTING.md
// "0. Ưu tiên"): thực thi Phôi/Hàn/Sơn/KCS, phân bổ đan, đề xuất mua hàng, chuyển kho/tồn
// kho giao dịch, đóng gói. Domain này chỉ phủ đúng 2 state machine "thật" đã được mock
// enforce role ở tầng service (assertBossRole/assertProdMgrRole): duyệt định mức SKU
// (PlanForm) và duyệt sản xuất theo từng SKU trong lệnh sản xuất (ProductionInvoiceItem).
// =====================================================================

enum SalesOrderItemStatus {
  LEN_KE_HOACH
  MUA_HANG
  KHUNG_CO_KHI
  DAN
  CHUYEN_KIEM
  DONG_GOI
  HOAN_THANH
}

/// DRAFT/REJECTED của mock đã bỏ - không service nào từng set 2 giá trị đó (rejections
/// đều rewind về IN_PROGRESS, xem PlanForm.reject-boss).
/// WAITING_QLSX_APPROVAL đã bỏ (bước QLSX duyệt cục bộ bị loại khỏi pipeline) - approveDetail()
/// giờ chuyển thẳng WAITING_BOSS_APPROVAL, xem migration remove_qlsx_sku_approval_step.
/// WAITING_PARTS/APPROVED_PARTS/WAITING_DETAIL/APPROVED_DETAIL đã gộp thành IN_PROGRESS (migration
/// planform_parallel_review) - mảnh và chi tiết giờ là 2 nhánh độc lập, tiến độ từng nhánh nằm ở
/// PlanForm.manhForwardedAt/detailForwardedAt thay vì suy ra từ vị trí tuyến tính của status.
enum PlanFormStatus {
  IN_PROGRESS
  WAITING_BOSS_APPROVAL
  APPROVED
}

enum ManhGroup {
  SAT
  DAY
  DINH
}

enum DetailGroup {
  DAY_SON
  VAT_TU_PHU_KIEN
  BAO_BI_DONG_GOI
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum ProductionInvoiceStatus {
  PLANNING
  PRODUCING
  DONE
  CANCELLED
}

enum ProdApprovalStatus {
  WAITING_QLSX
  WAITING_BOSS
  APPROVED
  REJECTED
}

model SalesOrder {
  id               BigInt    @id @default(autoincrement())
  code             String    @unique
  customerId       BigInt
  orderDate        DateTime
  /// Derived tại service (max của items[].deliveryDate) khi tạo/sửa item - không nhận
  /// trực tiếp từ client, giữ đúng hành vi mock (SalesPO.deliveryDate).
  deliveryDate     DateTime?
  depositAmount    Decimal   @default(0) @db.Decimal(14, 2)
  depositConfirmed Boolean   @default(false)
  paidAmount       Decimal   @default(0) @db.Decimal(14, 2)
  attachmentName   String?
  attachmentUrl    String?
  note             String?
  /// Tạm ngừng/huỷ đơn - tách biệt hoàn toàn khỏi deletedAt, cùng tinh thần User.isActive
  /// (xem docs/CONTRIBUTING.md mục 1).
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer               Customer                @relation(fields: [customerId], references: [id])
  items                  SalesOrderItem[]
  planForms              PlanForm[]
  productionInvoices     ProductionInvoice[]
  /// SKU của đơn này nằm rải ở các PI (kể cả PI gộp chung với đơn khác) - xem
  /// ProductionInvoiceItem.salesOrderId.
  productionInvoiceItems ProductionInvoiceItem[]

  @@index([customerId])
  @@index([deletedAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           BigInt               @id @default(autoincrement())
  salesOrderId BigInt
  mfgProductId BigInt
  skuName      String?
  totalQty     Int
  shippedQty   Int                  @default(0)
  status       SalesOrderItemStatus @default(LEN_KE_HOACH)
  deliveryDate DateTime?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  mfgProduct MfgProduct @relation(fields: [mfgProductId], references: [id])

  @@index([salesOrderId])
  @@index([mfgProductId])
  @@map("sales_order_items")
}

/// SKU quota-approval pipeline (KHSX tạo -> account chuyên trách nhập -> KHSX duyệt từng
/// nhóm -> Sếp duyệt cuối). manhData/detailQuota giữ tạm dạng JSON
/// (mirror đúng shape mock PlanForm.manhData/quotaManagement.materialType) - sẽ thay bằng
/// tham chiếu quan hệ thật tới Piece/Part/SegmentSpec/BomRevision ở phase viết lại Spec
/// pages (không thuộc phạm vi domain này).
model PlanForm {
  id                        BigInt         @id @default(autoincrement())
  /// Optional: SKU (kế hoạch sản xuất/BOM) là định nghĩa sản phẩm độc lập, không bắt buộc
  /// phải gắn 1 Sales Order ngay khi tạo (KHSX tạo trước, đơn hàng tham chiếu tới sau, hoặc
  /// không bao giờ gắn). NULL cho SKU thường tạo qua "Tạo SKU mới"; luôn có giá trị cho bản
  /// ghi origin='PRODUCTION_CONFIRM' (tạo khi Sếp duyệt 1 item PI thật).
  salesOrderId              BigInt?
  mfgProductId              BigInt
  productionInvoiceId       BigInt?
  /// Tên khách hàng nhập tay lúc tạo SKU (không suy ra được từ salesOrder khi SKU chưa/không
  /// gắn đơn hàng nào) - xem PlanFormsService.create.
  customerName              String?
  status                    PlanFormStatus @default(IN_PROGRESS)
  note                      String?
  /// null = SKU thường; 'PRODUCTION_CONFIRM' = bản ghi tự tạo khi Sếp duyệt PI item, chỉ
  /// để phục vụ Lệnh kiểm tra vật tư, ẩn khỏi mọi màn KHSX (mirror đúng hành vi mock).
  origin                    String?
  manhData                  Json?
  detailQuota               Json?
  /// KHSX đã "chốt xong" nhánh mảnh/chi tiết chưa - null = chưa, 2 nhánh tiến độc lập (không còn
  /// suy ra được từ status như trước). Khi CẢ HAI khác null, status tự chuyển WAITING_BOSS_APPROVAL
  /// (xem SkusService.advanceForwardedTrack). Nhập lại dữ liệu của 1 nhánh sau khi đã forward sẽ
  /// xoá field tương ứng về null (xem updateManhQuota/updateDetailQuota).
  manhForwardedAt           DateTime?
  detailForwardedAt         DateTime?
  /// Idempotency-Key của lần gọi POST .../approve gần nhất đã commit thành công - cho phép
  /// client retry (mất kết nối sau khi server đã commit) nhận lại đúng response cũ thay vì
  /// 409 do status không còn WAITING_BOSS_APPROVAL. Không tái sử dụng giữa 2 PlanForm khác
  /// nhau (unique) - trùng key ở đây luôn là lỗi client, không phải replay hợp lệ.
  bossApproveIdempotencyKey String?        @unique
  /// Lý do Sếp từ chối ở cổng duyệt cuối - null = chưa từng bị Sếp từ chối (hoặc lần từ chối gần
  /// nhất đã được xoá vì đã duyệt xong sau đó, xem SkusService.approve). Khác PlanFormManhReview/
  /// PlanFormDetailReview.reason (lý do KHSX từ chối từng nhánh) - 2 bảng đó bị xoá sạch khi Sếp
  /// từ chối (rewindToDetailReview) nên không còn chỗ giữ lý do ở tầng Sếp, phải có field riêng.
  bossRejectReason          String?
  createdById               String
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  salesOrder                SalesOrder?                @relation(fields: [salesOrderId], references: [id])
  mfgProduct                MfgProduct                 @relation(fields: [mfgProductId], references: [id])
  productionInvoice         ProductionInvoice?         @relation(fields: [productionInvoiceId], references: [id])
  createdBy                 User                       @relation(fields: [createdById], references: [id])
  manhReviews               PlanFormManhReview[]
  detailReviews             PlanFormDetailReview[]
  bomRevisions              BomRevision[]
  warehouseTransfers        WarehouseTransfer[]
  materialInspectionRequest MaterialInspectionRequest?

  @@index([salesOrderId])
  @@index([mfgProductId])
  @@index([productionInvoiceId])
  @@map("plan_forms")
}

/// Quyết định duyệt/từ chối của KHSX theo từng nhóm mảnh (Sắt/Dây/Đinh) - tách khỏi
/// PlanForm.status vì "1 trong 3 nhóm có dữ liệu" chỉ tự flip status, không có nghĩa là
/// KHSX đã duyệt (mirror đúng PlanForm.manhReviewStatus trong mock). Reject ở PlanForm xoá
/// sạch bảng này (không xoá manhData) - xem PlanFormsService.rejectToDetailReview.
model PlanFormManhReview {
  id         BigInt          @id @default(autoincrement())
  planFormId BigInt
  group      ManhGroup
  /// null = đã nhập định mức, CHƯA có quyết định duyệt (mirror manhEntryMeta tách khỏi
  /// manhReviewStatus trong mock) - assertAllApproved() chỉ đếm APPROVED, null không tính.
  status     ReviewDecision?
  reason     String?
  enteredBy  String?
  enteredAt  DateTime?
  reviewedAt DateTime?

  planForm PlanForm @relation(fields: [planFormId], references: [id])

  @@unique([planFormId, group])
  @@map("plan_form_manh_reviews")
}

/// Tương tự PlanFormManhReview nhưng cho 3 nhóm định mức chi tiết (Sơn/Phụ kiện/Bao bì).
model PlanFormDetailReview {
  id         BigInt          @id @default(autoincrement())
  planFormId BigInt
  group      DetailGroup
  status     ReviewDecision?
  reason     String?
  enteredBy  String?
  enteredAt  DateTime?
  reviewedAt DateTime?

  planForm PlanForm @relation(fields: [planFormId], references: [id])

  @@unique([planFormId, group])
  @@map("plan_form_detail_reviews")
}

/// Lệnh sản xuất - 1 PI có nhiều SKU (ProductionInvoiceItem), mỗi SKU tự chạy state
/// machine duyệt sản xuất riêng (prodApprovalStatus). PI tự chuyển PRODUCING khi mọi item
/// đã APPROVED (mirror đúng ProductionInvoiceService.approveItemByBoss trong mock).
model ProductionInvoice {
  id           BigInt                  @id @default(autoincrement())
  code         String                  @unique
  /// NULL cho PI gộp (isMerged) - các SKU bên trong có thể đến từ nhiều đơn hàng khác nhau nên
  /// không quy về 1 đơn được. PO gốc của từng SKU đọc ở ProductionInvoiceItem.salesOrderId.
  salesOrderId BigInt?
  status       ProductionInvoiceStatus @default(PLANNING)
  deadline     DateTime?
  /// true = KHSX tự gộp nhiều SKU lại để CẮT CHUNG một đợt (màn "Tối ưu cắt sắt"), khác hẳn PI
  /// vỏ 1-1 Sales tự sinh theo mỗi đơn hàng (createLinkedProductionInvoice). Hai loại có luồng
  /// duyệt KHÁC NHAU: PI gộp Sếp duyệt/từ chối CẢ CỤM một lần (approveBatch/rejectBatch, vì cả
  /// nhóm nằm chung một cây sắt, không tách lẻ được), PI thường vẫn duyệt từng SKU như cũ.
  isMerged     Boolean                 @default(false)
  mergedAt     DateTime?
  mergedById   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  salesOrder       SalesOrder?             @relation(fields: [salesOrderId], references: [id])
  mergedBy         User?                   @relation("PIMergedBy", fields: [mergedById], references: [id])
  items            ProductionInvoiceItem[]
  planForms        PlanForm[]
  cuttingProposals CuttingProposal[]
  steelIssues      SteelIssue[]

  @@index([salesOrderId])
  @@map("production_invoices")
}

model ProductionInvoiceItem {
  id                  BigInt              @id @default(autoincrement())
  productionInvoiceId BigInt
  /// PO (đơn hàng Sales) mà SKU này thuộc về. TRƯỚC ĐÂY suy ngược qua productionInvoice.salesOrder
  /// vì 1 PI = đúng 1 PO; từ khi có PI gộp (ProductionInvoice.isMerged) thì 1 PI chứa SKU của
  /// NHIỀU PO nên đường suy ngược đó mất dấu - phải ghim thẳng ở đây. Nullable vì SKU tạo tay qua
  /// POST /production-invoices/:id/items không bắt buộc gắn đơn hàng nào.
  salesOrderId        BigInt?
  mfgProductId        BigInt
  productVariantId    BigInt?
  quantity            Int
  materialDeadline    DateTime?
  deliveryDeadline    DateTime?
  prodApprovalStatus  ProdApprovalStatus?
  requestedAt         DateTime?
  requestedById       String?
  /// Kho thành phẩm QLSX chọn làm điểm cuối trước khi gửi Sếp duyệt (sendItemToBoss trong
  /// mock) - đây là warehouseScope (chuỗi tự do gắn trên User, vd 'thanh-pham-2'), KHÔNG phải
  /// FK tới bảng Warehouse (vốn chỉ có các mã kho vật lý cố định, không có khái niệm
  /// "kho thành phẩm 2/3" theo từng thủ kho) - cố ý lưu plain string, mirror đúng mock.
  warehouseCode       String?
  warehouseName       String?
  qlsxAt              DateTime?
  qlsxById            String?
  decidedAt           DateTime?
  decidedById         String?
  rejectReason        String?

  productionInvoice    ProductionInvoice            @relation(fields: [productionInvoiceId], references: [id])
  salesOrder           SalesOrder?                  @relation(fields: [salesOrderId], references: [id])
  mfgProduct           MfgProduct                   @relation(fields: [mfgProductId], references: [id])
  productVariant       ProductVariant?              @relation(fields: [productVariantId], references: [id])
  requestedBy          User?                        @relation("PIItemRequestedBy", fields: [requestedById], references: [id])
  qlsxBy               User?                        @relation("PIItemQlsxBy", fields: [qlsxById], references: [id])
  decidedBy            User?                        @relation("PIItemDecidedBy", fields: [decidedById], references: [id])
  stages               ProductionInvoiceItemStage[]
  productionOrder      ProductionOrder?
  transferCheckResults TransferCheckResult[]
  packagingRecords     PackagingRecord[]

  @@index([productionInvoiceId])
  @@index([mfgProductId])
  @@index([salesOrderId])
  @@map("production_invoice_items")
}

/// Mốc kế hoạch từng công đoạn do KHSX đặt riêng cho 1 SKU trong PI (LenhSXPage "Sửa thời hạn").
/// 4 mốc, chốt 2026-08-11, đúng thứ tự dây chuyền thật:
/// - FRAME: "Khung cơ khí" - mốc hoàn tất CẢ chuỗi Phôi→Hàn→Sơn (không phải riêng công đoạn Hàn,
///   dù field key lịch sử phía FE vẫn là `HAN` - xem toFeStageType/toBeStageType). KHÔNG tách
///   riêng Phôi/Hàn/Sơn ở đây vì đây chỉ là mốc kế hoạch, không phải theo dõi thực thi.
/// - WEAVING: "Đan".
/// - TRANSFER_CHECK: "Chuyền kiểm" - mốc DUY NHẤT trong 4 mốc có gắn dữ liệu thực thi thật
///   (xem model TransferCheckResult bên dưới) - khác 3 mốc còn lại chỉ có deadline thuần.
/// - PACKAGING: "Đóng gói" - field FE cũ tên `SON`, dễ nhầm với `MfgStage.SON` (Sơn/painting thật,
///   khác nghĩa) nên đặt tên rõ ràng hơn ở BE, adapter FE tự dịch qua lại.
enum ProdItemStageType {
  FRAME
  WEAVING
  TRANSFER_CHECK
  PACKAGING
}

model ProductionInvoiceItemStage {
  id                      BigInt            @id @default(autoincrement())
  productionInvoiceItemId BigInt
  stageType               ProdItemStageType
  deadline                DateTime

  productionInvoiceItem ProductionInvoiceItem @relation(fields: [productionInvoiceItemId], references: [id])

  @@unique([productionInvoiceItemId, stageType])
  @@map("production_invoice_item_stages")
}

/// Kết quả kiểm 1 mảnh tại công đoạn Chuyền kiểm (TRANSFER_CHECK) - mirror KhoChuyenKiemPage
/// (InboundWarehouse) FE. Mỗi lần bấm "Kiểm" tạo 1 dòng MỚI (không update-in-place lên dòng cũ)
/// nên "đã kiểm" cộng dồn qua SUM khi đọc - không có race lost-update kiểu shippedQty cũ (xem
/// SalesOrdersService.shipItem), 2 request kiểm song song chỉ đơn giản là 2 dòng độc lập.
/// totalQty của từng mảnh KHÔNG lưu ở đây - suy từ BomPiece.qtyPerUnit (theo đúng
/// ProductionOrder.bomRevisionId đã ghim) × ProductionOrder.quantity tại thời điểm đọc, xem
/// ProductionInvoicesService.listTransferCheckPieces(). "Chờ thực thi" (bao nhiêu đã sản xuất
/// xong, sẵn sàng để kiểm) suy từ SUM(WeavingReceipt.qty) - xem model WeavingReceipt (M2 "Phân
/// bổ/nhận hàng đan", đóng gap 2026-08-11).
model TransferCheckResult {
  id                      BigInt   @id @default(autoincrement())
  productionInvoiceItemId BigInt
  pieceId                 BigInt
  checkedQty              Int
  note                    String?
  checkedById             String
  checkedAt               DateTime @default(now())

  productionInvoiceItem ProductionInvoiceItem @relation(fields: [productionInvoiceItemId], references: [id])
  piece                 Piece                 @relation(fields: [pieceId], references: [id])
  checkedBy             User                  @relation("TransferCheckCheckedBy", fields: [checkedById], references: [id])
  defects               TransferCheckDefect[]

  @@index([productionInvoiceItemId, pieceId])
  @@map("transfer_check_results")
}

/// 1 lỗi phát hiện trong 1 lần kiểm - mirror loiEntries (lý do + ảnh đính kèm) ở KhoChuyenKiemPage.
model TransferCheckDefect {
  id                    BigInt  @id @default(autoincrement())
  transferCheckResultId BigInt
  reason                String
  imageUrl              String?

  transferCheckResult TransferCheckResult @relation(fields: [transferCheckResultId], references: [id])

  @@index([transferCheckResultId])
  @@map("transfer_check_defects")
}

/// Kết quả đóng gói tại công đoạn PACKAGING - mirror TransferCheckResult (append-only, SUM-
/// on-read, không lost-update) NHƯNG đơn giản hơn: theo dõi theo ProductionInvoiceItem (không
/// theo BomPiece - "Thùng thành phẩm" là 1 dòng duy nhất/SKU, không tách theo mảnh), và không
/// có sub-bảng defect (đóng gói hiện không có khái niệm QC/lỗi). totalQty KHÔNG lưu ở đây -
/// suy trực tiếp từ ProductionOrder.quantity tại thời điểm đọc (KHÔNG qua PackagingBom - model
/// đó là định mức tiêu hao vật tư đóng gói, không phải "bao nhiêu thùng"). Quyết định nghiệp vụ
/// 2026-08-12: KHÔNG chặn theo SUM(TransferCheckResult.checkedQty) - chỉ chặn vượt totalQty.
model PackagingRecord {
  id                      BigInt   @id @default(autoincrement())
  productionInvoiceItemId BigInt
  boxesPacked             Int
  note                    String?
  packedById              String
  packedAt                DateTime @default(now())

  productionInvoiceItem ProductionInvoiceItem @relation(fields: [productionInvoiceItemId], references: [id])
  packedBy              User                  @relation(fields: [packedById], references: [id])

  @@index([productionInvoiceItemId])
  @@map("packaging_records")
}

// =====================================================================
// Phase 7 — Production Order & Cutting Proposal (tích hợp cat_sat_iea)
// Nguồn: docs/dna-erp-backend-implementation-plan.md mục Phase 7, điều chỉnh theo quyết
// định thiết kế thật (2026-08-05): ProductionOrder KHÔNG có API tạo/release thủ công ở bản
// đầu - tự động tạo + tự động release ngay trong ProductionInvoicesService.approveItem(),
// ngay sau khi Sếp duyệt 1 SKU (không có màn hình riêng, không loading state cho Sếp chờ).
// quantity ghim (snapshot) từ productionInvoiceItem.quantity tại thời điểm đó - giá trị này
// do Sales tạo và KHÔNG ai được sửa sau đó (xác nhận nghiệp vụ), nên ghim là an toàn tuyệt
// đối, không có rủi ro lệch nguồn.
// =====================================================================

enum ProductionOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CuttingProposalStatus {
  /// Đang chờ solver trả kết quả (fire-and-forget, ngay sau khi tạo request).
  CALCULATING
  DRAFT
  APPROVED
  SUPERSEDED
  /// Solver lỗi/timeout/không khả thi - xem errorMessage. Khác REJECTED (không tồn tại ở bản
  /// này) vì đây là lỗi kỹ thuật, không phải quyết định nghiệp vụ từ chối phương án.
  FAILED
}

/// Lệnh sản xuất tại xưởng - tự động sinh 1-1 từ 1 ProductionInvoiceItem khi Sếp duyệt (xem
/// approveItem()). KHÔNG có API tạo/release thủ công ở bản này (đã có sẵn trong doc gốc,
/// để dành khi cần tách 1 item thành nhiều PO chạy tuần tự - chưa cần tới lúc này).
model ProductionOrder {
  id                      BigInt                @id @default(autoincrement())
  poNumber                String                @unique
  /// 1-1 với item đã duyệt sinh ra PO này - chỉ để truy vết, KHÔNG dùng để đọc lại quantity
  /// (đã ghim ở field quantity bên dưới).
  productionInvoiceItemId BigInt                @unique
  mfgProductId            BigInt
  /// Ghim tại thời điểm tạo (ACTIVE BomRevision của mfgProductId lúc đó) - không suy lại mỗi
  /// lần đọc, đúng nguyên tắc PO ghim đúng 1 bản định mức.
  bomRevisionId           BigInt
  /// Snapshot productionInvoiceItem.quantity tại thời điểm duyệt - xem ghi chú đầu section.
  quantity                Int
  status                  ProductionOrderStatus @default(RELEASED)
  releasedAt              DateTime?             @default(now())
  createdAt               DateTime              @default(now())

  productionInvoiceItem       ProductionInvoiceItem        @relation(fields: [productionInvoiceItemId], references: [id])
  mfgProduct                  MfgProduct                   @relation(fields: [mfgProductId], references: [id])
  bomRevision                 BomRevision                  @relation(fields: [bomRevisionId, mfgProductId], references: [id, mfgProductId])
  cuttingProposals            CuttingProposal[]
  weavingIssues               WeavingIssue[]
  weavingReceipts             WeavingReceipt[]
  materialIssues              MaterialIssue[]
  productionBatches           ProductionBatch[]
  materialInspectionRequests  MaterialInspectionRequest[]
  warehouseTransferPieceItems WarehouseTransferPieceItem[]

  @@index([mfgProductId])
  @@map("production_orders")
}

/// 1 lần gọi solver cat_sat_iea. cat_sat_iea không lưu gì (stateless) - toàn bộ input/output
/// nguyên văn lưu ở đây để audit/replay (rawResponse), còn dữ liệu cần truy vấn lại (bar_count
/// theo material cho Phase 8 Mua hàng, pattern/segment cho Phase 9 Phôi cắt theo) tách thành 3
/// bảng con chuẩn hoá bên dưới - KHÔNG gộp hết vào JSON.
///
/// Neo vào ĐÚNG MỘT trong hai (bất biến, enforce ở service - xem assertExactlyOneAnchor):
/// - productionOrderId: 1 SKU cắt riêng (đường mặc định, có từ Phase 7).
/// - productionInvoiceId: cả một PI gộp cắt CHUNG một đợt. Bắt buộc phải là 1 bản ghi duy nhất
///   cho cả nhóm, KHÔNG phải mỗi SKU một bản: gộp chỉ tiết kiệm được sắt khi các đoạn của nhiều
///   SKU nằm trên CÙNG một cây - tách ra tính riêng là mất sạch phần lợi.
model CuttingProposal {
  id                  BigInt                @id @default(autoincrement())
  productionOrderId   BigInt?
  productionInvoiceId BigInt?
  status              CuttingProposalStatus @default(CALCULATING)
  /// Client-supplied UUID cho lần gọi thủ công (nút "Tính lại") - null cho lần tự động đầu
  /// tiên (không cần, vì unique(productionInvoiceItemId) trên ProductionOrder đã chặn tạo
  /// trùng PO, nên chỉ có đúng 1 lần tự động/PO).
  idempotencyKey      String?               @unique
  /// Toàn bộ input đã gửi solver (num_sets, bom[], stock_lengths, trim_start...) - audit/replay.
  requestParams       Json?
  /// Nguyên văn response solver (purchase_plan[], summary...) khi thành công.
  rawResponse         Json?
  totalBarsAll        Int?
  totalWasteMm        Int?
  wastePercentage     Decimal?              @db.Decimal(6, 3)
  /// Lý do lỗi/timeout/không khả thi khi status=FAILED (bao gồm failing_materials nếu có).
  errorMessage        String?
  requestedAt         DateTime              @default(now())
  requestedById       String?
  completedAt         DateTime?
  approvedAt          DateTime?
  approvedById        String?
  /// true nếu có ≥1 dòng lines[] feasible=false - suy ra lúc saveSuccess() để LỌC ĐƯỢC BẰNG SQL
  /// (không phải kéo lines[] về rồi lọc ở code) - phục vụ màn Cắt sắt sẽ poll định kỳ, xem
  /// mục 15 changelog-2026-08-15.
  hasInfeasibleLine   Boolean               @default(false)
  /// true nếu có ≥1 dòng lines[] feasible=true nhưng overThreshold=true. Cùng lý do tồn tại với
  /// hasInfeasibleLine ở trên.
  hasOverThreshold    Boolean               @default(false)

  productionOrder   ProductionOrder?      @relation(fields: [productionOrderId], references: [id])
  productionInvoice ProductionInvoice?    @relation(fields: [productionInvoiceId], references: [id])
  requestedBy       User?                 @relation("CuttingProposalRequestedBy", fields: [requestedById], references: [id])
  approvedBy        User?                 @relation("CuttingProposalApprovedBy", fields: [approvedById], references: [id])
  lines             CuttingProposalLine[]
  purchaseProposals PurchaseProposal[]

  @@index([productionOrderId, status])
  @@index([productionInvoiceId, status])
  @@map("cutting_proposals")
}

/// 1 dòng/loại sắt (gom theo material) trong 1 CuttingProposal - purchase_plan[] của solver.
/// bar_count ở đây là NGUỒN CHÍNH XÁC cho Phase 8 (inspection_items.required vật tư sắt),
/// ưu tiên hơn ước lượng thô qua BOM - xem docs/dna-erp-backend-implementation-plan.md 8.1.
model CuttingProposalLine {
  id                   BigInt   @id @default(autoincrement())
  cuttingProposalId    BigInt
  materialId           BigInt
  feasible             Boolean  @default(true)
  bestStockLengthMm    Int?
  totalBars            Int?
  totalWasteMm         Int?
  wastePercentage      Decimal? @db.Decimal(6, 3)
  /// Tổng chiều dài mẩu sắt còn NGUYÊN (chưa cắt, từ cây cắt dở) của loại sắt này - nhập kho,
  /// cắt được cỡ bất kỳ sau này. KHÔNG phải phế liệu/hao hụt. Phôi cần biết số này để nhập kho
  /// đúng, xem thêm CuttingProposalPattern.mauNguyenMm (chi tiết cây nào cắt dở).
  mauNguyenMm          Int?     @default(0)
  /// So sánh hao hụt giữa các chiều dài chuẩn đã chấm (vd [{length:5850,bars:227,wastePct:9.61},
  /// {length:6000,bars:223,wastePct:0.85}]) - thuần hiển thị/audit, không có FK nào cần tới nên
  /// giữ JSON thay vì tách bảng.
  lengthComparison     Json?
  /// Lý do KHÔNG cắt được (feasible=false), NGUYÊN VĂN từ solver (api/views.py::_no_solution/
  /// _unsolved) - vd "Không có cách cắt nào đạt ngưỡng 1% hao hụt...". Trước 2026-08-19 field
  /// này bị vứt bỏ hoàn toàn (không lưu) - FE chỉ hiện được "Không khả thi" trơ trọi, không nói
  /// được vì sao. Null khi feasible=true.
  reason               String?
  /// Chỉ có khi feasible=false NHƯNG solver vẫn tính được "tốt nhất có thể" (vd {length:6000,
  /// waste_pct:2.4,bars:5}) - cho biết nới ngưỡng lên bao nhiêu thì đạt. KHÁC timedOut=true (chưa
  /// kết luận được gì cả) - 2 ca này KHÔNG được gộp chung một nhãn hiển thị, xem changelog
  /// 2026-08-15 mục 15.5-(b).
  bestAchievable       Json?
  /// true = CP-SAT hết time_limit_seconds mà CHƯA kết luận được (status UNKNOWN), KHÁC hẳn
  /// infeasible THẬT (đã chứng minh vô nghiệm, status INFEASIBLE). Null/false khi feasible=true
  /// hoặc vô nghiệm thật.
  ///
  /// KHÔNG có cột patternsTruncated riêng: solver TÍNH ra cờ đó nội bộ
  /// (cat_sat/de_xuat_logic.py::optimize_material, "hết ENUM_TIME_LIMIT trước khi liệt kê xong
  /// pattern") nhưng api/views.py KHÔNG forward field này ra JSON response - chỉ timed_out/
  /// best_achievable/reason/max_waste_pct_threshold thật sự lọt tới client. Phát hiện khi đọc lại
  /// nguyên văn views.py lúc code phần lưu (2026-08-19) - kế hoạch ban đầu (changelog 2026-08-15
  /// mục 15.3/15.6) liệt kê nhầm patterns_truncated là 1 trong các field "solver gửi kèm".
  timedOut             Boolean?
  /// Ngưỡng hao hụt % ĐÃ ÁP DỤNG cho loại sắt này khi solver chấm (riêng theo
  /// Material.maxCuttingWastePercentage, hoặc SystemConfig.solverMaxWastePercentage mặc định) -
  /// có mặt ở CẢ 2 nhánh feasible/infeasible trong response. Không suy lại từ SystemConfig lúc
  /// hiển thị vì ngưỡng có thể đã đổi kể từ khi phương án này được tính.
  maxWastePctThreshold Decimal? @db.Decimal(6, 3)
  /// true = feasible=true NHƯNG vượt maxWastePctThreshold của chính loại sắt này. Trước 2026-08-19
  /// field over_threshold trong response solver bị bỏ qua hoàn toàn ở cổng chặn tự-duyệt - hệ
  /// thống từng tự duyệt/trừ kho/tạo đề xuất mua cho các phương án vượt ngưỡng, không ai biết
  /// (đã vá ở autoApproveBlockReason() nhánh (c), xem changelog 2026-08-15 mục 15.9). Null khi
  /// feasible=false - field chỉ xuất hiện ở dòng feasible trong response thật (api/views.py).
  overThreshold        Boolean?

  cuttingProposal CuttingProposal          @relation(fields: [cuttingProposalId], references: [id])
  material        Material                 @relation(fields: [materialId], references: [id])
  patterns        CuttingProposalPattern[]

  @@index([cuttingProposalId])
  @@index([materialId])
  @@map("cutting_proposal_lines")
}

/// 1 kiểu cắt (cutting_patterns[] của solver, theo từng loại sắt) - Phôi cắt theo đúng
/// pattern nào tra ngược qua bảng này (Phase 9, cut_pattern_segment FK tới đây).
model CuttingProposalPattern {
  id            BigInt @id @default(autoincrement())
  lineId        BigInt
  patternIndex  Int
  barCount      Int
  wastePerBarMm Int?
  /// > 0 nghĩa là cây thuộc pattern này CẮT DỞ (dừng sớm, phần còn lại để nguyên nhập kho) -
  /// đa số pattern có giá trị 0, chỉ pattern "cây cuối" của 1 loại sắt mới có mẩu nguyên.
  mauNguyenMm   Int?   @default(0)

  line       CuttingProposalLine             @relation(fields: [lineId], references: [id])
  segments   CuttingProposalPatternSegment[]
  cutBundles CutBundle[]

  @@index([lineId])
  @@map("cutting_proposal_patterns")
}

/// 1 cỡ đoạn + số lượng/cây trong 1 pattern (pieces_breakdown[] của solver).
model CuttingProposalPatternSegment {
  id            BigInt @id @default(autoincrement())
  patternId     BigInt
  segmentSpecId BigInt
  countPerBar   Int

  pattern     CuttingProposalPattern @relation(fields: [patternId], references: [id])
  segmentSpec SegmentSpec            @relation(fields: [segmentSpecId], references: [id])

  @@index([patternId])
  @@index([segmentSpecId])
  @@map("cutting_proposal_pattern_segments")
}

// =====================================================================
// Phase 8 — Mua hàng (rút gọn: chỉ vật tư sắt, nối thẳng từ CuttingProposal đã duyệt)
// Quyết định nghiệp vụ (2026-08-06): CHƯA đối chiếu tồn kho thật (StockQuant) ở bản này -
// buyQty = CuttingProposalLine.totalBars nguyên văn, không trừ tồn. Khi nào cần đối chiếu
// tồn kho thì thêm cột/migration riêng lúc đó, không đoán trước field chưa dùng tới ở đây.
// 1 PurchaseProposal tự sinh ngay khi CuttingProposal chuyển APPROVED (xem
// CuttingProposalsService.approve()).
// Mở rộng Phase 10 (2026-08-12): thêm nhánh tạo thủ công từ Kiểm tra vật tư (sourceType=
// MATERIAL_INSPECTION, cuttingProposalId nullable) - xem model InspectionKhoResult.
// actualStock/buyQty/receivedQty đổi Int→Decimal(14,4) cùng dịp (vật tư phi-sắt như sơn có
// số lẻ, khác sắt luôn nguyên cây - Int trước đây chỉ đủ cho nhánh CUTTING_PROPOSAL).
// =====================================================================

enum PurchaseProposalStatus {
  NEW
  QUOTING
  SUBMITTED
  PURCHASING
  PURCHASED
  REJECTED
}

enum PurchaseProposalSource {
  CUTTING_PROPOSAL
  MATERIAL_INSPECTION
}

/// Tự sinh 1-1 theo (cuttingProposalId, warehouseCode) ngay khi CuttingProposal được duyệt
/// (sourceType=CUTTING_PROPOSAL, cuttingProposalId luôn có giá trị), HOẶC tạo thủ công từ 1
/// InspectionKhoResult đã SUBMITTED (sourceType=MATERIAL_INSPECTION, cuttingProposalId luôn
/// null) - xem PurchaseProposalsService.createFromInspection(). inspectionKhoResultId @unique
/// tự đảm bảo tối đa 1 đề xuất/kho-result (Postgres cho phép nhiều NULL nhưng không cho phép
/// trùng giá trị non-null) - mạnh hơn @@unique([cuttingProposalId, warehouseCode]) cũ (vẫn giữ
/// nguyên, chỉ còn ý nghĩa với nhánh CUTTING_PROPOSAL vì nhánh kia cuttingProposalId luôn null).
model PurchaseProposal {
  id                    BigInt                 @id @default(autoincrement())
  cuttingProposalId     BigInt?
  inspectionKhoResultId BigInt?                @unique
  sourceType            PurchaseProposalSource @default(CUTTING_PROPOSAL)
  /// Idempotency-Key của lần gọi tạo thủ công (createFromInspection) - cùng idiom
  /// PlanForm.bossApproveIdempotencyKey/MaterialIssue.idempotencyKey. NULL cho mọi dòng tự
  /// sinh từ CuttingProposal.approve() (đã tự idempotent qua unique (cuttingProposalId,
  /// warehouseCode) sẵn có, không cần thêm).
  idempotencyKey        String?                @unique
  warehouseCode         String
  status                PurchaseProposalStatus @default(NEW)
  createdAt             DateTime               @default(now())
  submittedAt           DateTime?
  approvedAt            DateTime?
  approvedById          String?
  rejectedAt            DateTime?
  rejectionReason       String?
  purchasedAt           DateTime?

  cuttingProposal     CuttingProposal?       @relation(fields: [cuttingProposalId], references: [id])
  inspectionKhoResult InspectionKhoResult?   @relation(fields: [inspectionKhoResultId], references: [id])
  approvedBy          User?                  @relation(fields: [approvedById], references: [id])
  items               PurchaseProposalItem[]

  @@unique([cuttingProposalId, warehouseCode])
  @@index([status])
  @@map("purchase_proposals")
}

/// 1 dòng vật tư cần mua - materialId tra ngược Material để lấy code/name/unit khi trả DTO
/// (giống hệt cách CuttingProposalLine không snapshot name/unit), không lưu trùng lặp.
model PurchaseProposalItem {
  id                      BigInt   @id @default(autoincrement())
  proposalId              BigInt
  materialId              BigInt
  /// Tồn thật (stock_quant) chụp đúng lúc dòng này được tạo (CuttingProposalsService.approve()
  /// cho nhánh sắt, hoặc InspectionKhoResultItem.actualStock đã chốt lúc submitKho cho nhánh
  /// kiểm tra vật tư) - không tính lại theo thời gian thực (giống buyQty, là số chốt).
  actualStock             Decimal  @default(0) @db.Decimal(14, 4)
  buyQty                  Decimal  @db.Decimal(14, 4)
  receivedQty             Decimal  @default(0) @db.Decimal(14, 4)
  /// Cộng dồn số lượng thực nhận theo purchaseUnit của material (vd kg) - chỉ để đối chiếu/audit,
  /// không dùng để tính tồn kho (receivedQty theo unit mới là số chốt vào StockLedger).
  receivedQtyPurchaseUnit Decimal? @db.Decimal(14, 4)

  proposal PurchaseProposal        @relation(fields: [proposalId], references: [id])
  material Material                @relation(fields: [materialId], references: [id])
  quotes   PurchaseProposalQuote[]

  @@index([proposalId])
  @@map("purchase_proposal_items")
}

/// Báo giá NCC cho 1 dòng vật tư - Purchasing thêm nhiều dòng/item, Sếp chọn đúng 1
/// (isChosen) lúc approve().
model PurchaseProposalQuote {
  id           BigInt    @id @default(autoincrement())
  itemId       BigInt
  supplierId   BigInt?
  supplierName String
  unitPrice    Decimal?  @db.Decimal(14, 2)
  expectedDate DateTime?
  note         String?
  isChosen     Boolean   @default(false)

  item     PurchaseProposalItem @relation(fields: [itemId], references: [id])
  supplier Supplier?            @relation(fields: [supplierId], references: [id])

  @@index([itemId])
  @@map("purchase_proposal_quotes")
}

// =====================================================================
// Phase 10 — Kiểm tra vật tư trước sản xuất (mirror InspectionContext.requests/SEED_REQUESTS
// FE, hiện 100% mock). Neo vào PlanForm(origin='PRODUCTION_CONFIRM') - bản ghi đã tự tạo sẵn
// khi Sếp duyệt 1 PI item (xem SkusService.ensureProductionConfirmPlanForm), doc-comment trên
// PlanForm.origin đã nói rõ mục đích duy nhất là phục vụ domain này.
// productionOrderId chụp NGAY lúc tạo request (ProductionOrder đã tồn tại từ approveItem() -
// xem ProductionInvoicesService.approveItem()) - cho required = rate × quantity, và cho
// PurchaseProposalsService đọc poNumber/mfgProduct đối xứng với nhánh CUTTING_PROPOSAL.
// =====================================================================

enum InspectionKhoStatus {
  PENDING
  SUBMITTED
}

/// 1 "Lệnh kiểm tra vật tư" - luôn đúng 3 InspectionKhoResult con (phoi-son-han/vat-tu-tp/
/// thanh-pham). productionStarted chỉ là cờ đánh dấu KHSX đã bấm "Bắt đầu sản xuất" sau khi
/// đủ 3 kho SUBMITTED - không có side-effect gì khác ở BE (2 API sync định mức sắt vẫn ở FE).
model MaterialInspectionRequest {
  id                  BigInt    @id @default(autoincrement())
  planFormId          BigInt    @unique
  productionOrderId   BigInt
  productionStarted   Boolean   @default(false)
  productionStartedAt DateTime?
  createdById         String
  createdAt           DateTime  @default(now())

  planForm        PlanForm              @relation(fields: [planFormId], references: [id])
  productionOrder ProductionOrder       @relation(fields: [productionOrderId], references: [id])
  createdBy       User                  @relation(fields: [createdById], references: [id])
  khoResults      InspectionKhoResult[]

  @@map("material_inspection_requests")
}

/// 1 dòng/kho (đúng 3: phoi-son-han/vat-tu-tp/thanh-pham) cho 1 request - warehouseCode plain
/// string khớp Warehouse.code, KHÔNG FK cứng tới Warehouse (cùng idiom PurchaseProposal.
/// warehouseCode/ProductionInvoiceItem.warehouseCode).
model InspectionKhoResult {
  id            BigInt              @id @default(autoincrement())
  requestId     BigInt
  warehouseCode String
  status        InspectionKhoStatus @default(PENDING)
  submittedAt   DateTime?
  submittedById String?

  request          MaterialInspectionRequest @relation(fields: [requestId], references: [id])
  submittedBy      User?                     @relation(fields: [submittedById], references: [id])
  items            InspectionKhoResultItem[]
  purchaseProposal PurchaseProposal?

  @@unique([requestId, warehouseCode])
  @@map("inspection_kho_results")
}

/// 1 dòng vật tư trong 1 kho-result. materialId nullable + name/unit snapshot (không phải live
/// join) - mirror PurchaseProposalItem/CuttingProposalLine, phòng dòng không map được vật tư
/// thật (hiện tại KHÔNG xảy ra - mọi dòng dựng từ PieceBom/PieceMaterialItem/ConsumableBom/
/// BomAccessoryItem qua SkusService.reconstructQuotaBatch đều có materialId thật). required/
/// actualStock dùng Decimal (không phải Int) vì gồm cả đơn vị phân số (kg sơn, m dây...).
model InspectionKhoResultItem {
  id           BigInt   @id @default(autoincrement())
  khoResultId  BigInt
  materialId   BigInt?
  materialName String
  materialUnit String
  required     Decimal  @db.Decimal(14, 4)
  actualStock  Decimal? @db.Decimal(14, 4)

  khoResult InspectionKhoResult @relation(fields: [khoResultId], references: [id])
  material  Material?           @relation(fields: [materialId], references: [id])

  @@index([khoResultId])
  @@map("inspection_kho_result_items")
}

// ===== Phase 3 — Kho vận lõi (Ledger Core, docs/dna-erp-db-schema.html mục 1.8) =====

enum StockLedgerRefType {
  PURCHASE
  STEEL_ISSUE
  QC_SCRAP
  SURPLUS_POSTING
  SEGMENT_CONSUME
  FRAME_OUTPUT
  FINISHED
  MATERIAL_ISSUE
  WAREHOUSE_TRANSFER
  ADJUST
  OPENING_BALANCE
}

enum TransferStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
}

/// Nguồn sinh ra 1 StockReservation. Mỗi giá trị ứng với 1 luồng nghiệp vụ có bước "hứa trước, lấy
/// sau" - thêm giá trị mới khi mở luồng mới, không dùng lại giá trị của luồng khác.
enum StockReservationRefType {
  /// Duyệt phương án cắt sắt giữ phần tồn sẵn có cho lệnh SX/đợt gộp đó (CuttingProposalsService).
  CUTTING_PROPOSAL
  /// Sắt mua về đã có chủ - giữ đích danh cho đề xuất đã kích hoạt mua (PurchaseProposalsService).
  PURCHASE_PROPOSAL
}

/// Sổ cái kho bút toán kép - nguồn sự thật duy nhất của tồn kho. Append-only: không có
/// update()/remove() nào ở service, chỉ StockLedgerService.postEntry() (dùng chung bởi mọi
/// module ghi kho ở các Phase sau) + 1 ngoại lệ điều chỉnh thủ công (POST /stock-ledger/adjust).
/// Mỗi dòng = 1 sự di chuyển from -> to, hàng không sinh ra/mất đi; tồn 1 kho =
/// Σqty(to=kho) − Σqty(from=kho). stock_quant (bên dưới) cache lại số dư này qua trigger DB.
model StockLedger {
  id               BigInt             @id @default(autoincrement())
  fromWarehouseId  BigInt
  toWarehouseId    BigInt
  /// XOR - đúng 1 trong 4 chân hàng khác NULL (CHECK ở migration, enforce lại ở service để
  /// trả 400 rõ ràng thay vì để lộ lỗi CHECK constraint thô).
  materialId       BigInt?
  segmentSpecId    BigInt?
  pieceId          BigInt?
  productVariantId BigInt?
  qty              Decimal            @db.Decimal(16, 4)
  refType          StockLedgerRefType
  /// Trỏ tới bản ghi nguồn gốc (vd warehouse_transfers.id) - không FK cứng vì đa bảng tuỳ
  /// refType, giống audit_logs.recordId.
  refId            String?
  /// Chỉ có giá trị cho refType=ADJUST - HTTP layer bắt buộc header Idempotency-Key; unique để
  /// service resolve-or-return khi client gọi lại đúng key (cùng idiom P2002 resolve-or-create
  /// đã dùng ở SkusService.resolveDraftBomRevision).
  idempotencyKey   String?            @unique
  /// Không có trong bảng cột gốc ở dna-erp-db-schema.html mục 1.8, nhưng CreateStockAdjustmentDto
  /// (mục 3.1 cùng tài liệu) có field này - thêm để không mất lý do điều chỉnh thủ công.
  note             String?
  createdAt        DateTime           @default(now())
  createdById      String?

  fromWarehouse  Warehouse       @relation("StockLedgerFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse    Warehouse       @relation("StockLedgerToWarehouse", fields: [toWarehouseId], references: [id])
  material       Material?       @relation(fields: [materialId], references: [id])
  segmentSpec    SegmentSpec?    @relation(fields: [segmentSpecId], references: [id])
  piece          Piece?          @relation(fields: [pieceId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  createdBy      User?           @relation(fields: [createdById], references: [id])

  @@index([toWarehouseId, materialId])
  @@index([fromWarehouseId, materialId])
  @@index([toWarehouseId, segmentSpecId])
  @@index([fromWarehouseId, segmentSpecId])
  @@index([toWarehouseId, pieceId])
  @@index([fromWarehouseId, pieceId])
  @@index([toWarehouseId, productVariantId])
  @@index([fromWarehouseId, productVariantId])
  @@map("stock_ledger")
}

/// Cache số dư tồn kho, materialize từ StockLedger bằng trigger DB (fn_sync_stock_quant, xem
/// migration - AFTER INSERT ON stock_ledger) - KHÔNG phải nguồn sự thật, app không bao giờ
/// ghi trực tiếp vào bảng này (chỉ đọc qua StockQuantService.findAll()).
model StockQuant {
  id               BigInt   @id @default(autoincrement())
  warehouseId      BigInt
  materialId       BigInt?
  segmentSpecId    BigInt?
  pieceId          BigInt?
  productVariantId BigInt?
  qty              Decimal  @default(0) @db.Decimal(16, 4)
  updatedAt        DateTime @default(now())

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  material       Material?       @relation(fields: [materialId], references: [id])
  segmentSpec    SegmentSpec?    @relation(fields: [segmentSpecId], references: [id])
  piece          Piece?          @relation(fields: [pieceId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@map("stock_quant")
}

/// Giữ chỗ tồn kho ("đã hứa cho ai đó, chưa lấy đi") - tách khái niệm ĐẶT GIỮ khỏi TIÊU HAO, xem
/// docs/changelog-2026-08-15-nhip-2-gop-sku-va-review-auto-duyet.md mục 13 (thiết kế B4) và
/// DNA-ERP/docs/thiet-ke-giu-cho-khau-tru-ton-kho.md (bản logic gốc 2026-06-27).
///
/// KHÁC StockLedger: bảng này KHÔNG làm đổi tồn vật lý (stock_quant), chỉ làm giảm tồn KHẢ DỤNG
/// (available = onHand - Σ giữ chỗ ACTIVE chưa tiêu thụ hết). Hàng vẫn nằm trên giá cho tới khi có
/// bút toán StockLedger thật.
///
/// refType/refId đi theo đúng idiom StockLedger.refId ở trên (không FK cứng đa bảng) - 1 bảng dùng
/// chung cho mọi luồng cần giữ chỗ, thay vì mỗi luồng một bảng riêng rồi quên cộng vào công thức
/// available. `WarehouseTransferReservation` (bên dưới) là bảng có TRƯỚC bảng này, đang phục vụ
/// riêng luồng chuyển kho - cố ý CHƯA migrate sang đây để không phải đụng code chuyển kho đang chạy
/// tốt; đổi lại, mọi nơi tính available BẮT BUỘC đi qua đúng 1 hàm dùng chung
/// (StockReservationsService.getAvailableQty) - hàm đó cộng cả HAI bảng.
model StockReservation {
  id             BigInt                  @id @default(autoincrement())
  warehouseId    BigInt
  materialId     BigInt
  /// Số lượng đã hứa. Bất biến sau khi tạo - phần đã lấy đi ghi ở consumedQty, không trừ vào đây
  /// (giữ được "hứa bao nhiêu / lấy bao nhiêu" để đối chiếu).
  quantity       Decimal                 @db.Decimal(16, 4)
  /// Cộng dồn phần đã thực xuất - Phôi lấy sắt làm nhiều đợt (giữ 100 cây, xuất 30/40/30). Khi
  /// consumedQty >= quantity thì status chuyển RELEASED, dòng hết chiếm chỗ.
  consumedQty    Decimal                 @default(0) @db.Decimal(16, 4)
  status         ReservationStatus       @default(ACTIVE)
  refType        StockReservationRefType
  /// Trỏ tới bản ghi nghiệp vụ giữ chỗ này (vd cutting_proposals.id) - cùng lý do không FK cứng
  /// như StockLedger.refId.
  refId          String
  /// Chống tạo trùng khi caller gọi lại (cùng idiom StockLedger.idempotencyKey). Đặt theo công
  /// thức cố định `<refType>:<refId>:material:<materialId>` chứ không phải UUID client gửi lên -
  /// 1 (nguồn, vật tư) chỉ được giữ chỗ đúng 1 dòng.
  idempotencyKey String?                 @unique
  note           String?
  createdAt      DateTime                @default(now())
  createdById    String?
  releasedAt     DateTime?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  /// Đúng chỉ mục cho câu hỏi nóng nhất: "vật tư X ở kho Y đang bị giữ bao nhiêu" (getAvailableQty).
  @@index([warehouseId, materialId, status])
  @@index([refType, refId])
  @@map("stock_reservations")
}

/// Phiếu chuyển kho nội bộ - lớp workflow ngồi trên StockLedger. State machine 1 chiều
/// PENDING -> CONFIRMED|REJECTED, không quay lại. confirm() là nơi duy nhất ghi StockLedger
/// cho luồng transfer (qua StockLedgerService.postEntry(), ref_type=WAREHOUSE_TRANSFER).
model WarehouseTransfer {
  id              BigInt         @id @default(autoincrement())
  code            String         @unique
  fromWarehouseId BigInt
  toWarehouseId   BigInt
  status          TransferStatus @default(PENDING)
  /// Chuẩn hoá từ pi_code (string) hiện tại ở mock.
  planFormId      BigInt?
  rejectionReason String?
  note            String?
  createdAt       DateTime       @default(now())
  confirmedAt     DateTime?
  rejectedAt      DateTime?

  fromWarehouse Warehouse                      @relation("WarehouseTransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse                      @relation("WarehouseTransferToWarehouse", fields: [toWarehouseId], references: [id])
  planForm      PlanForm?                      @relation(fields: [planFormId], references: [id])
  items         WarehouseTransferItem[]
  pieceItems    WarehouseTransferPieceItem[]
  reservations  WarehouseTransferReservation[]

  @@index([status])
  @@index([toWarehouseId, status])
  @@map("warehouse_transfers")
}

/// Dòng vật tư trong 1 phiếu chuyển kho.
model WarehouseTransferItem {
  id           BigInt  @id @default(autoincrement())
  transferId   BigInt
  /// Nullable - kế thừa hạn chế của mock (match theo materialName chuẩn hoá khi chưa chọn đúng
  /// Material thật, xem dna-erp-db-schema.html mục 1.8 "câu hỏi mở"). Chỉ dòng có materialId
  /// mới ghi được StockLedger lúc confirm() - dòng free-text không có gì để XOR vào ledger.
  materialId   BigInt?
  materialName String
  unit         String
  /// Đã clamp theo tồn khả dụng (stock_quant trừ reservation ACTIVE) tại thời điểm tạo phiếu.
  quantity     Decimal @db.Decimal(16, 4)
  note         String?

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id])
  material Material?         @relation(fields: [materialId], references: [id])

  @@index([transferId])
  @@map("warehouse_transfer_items")
}

/// Dòng mảnh trong 1 phiếu chuyển kho piece-only (docs/review-2026-08-17-sanxuat-stage-v16-va-
/// chuyen-kho-manh.md mục 7) - tách riêng khỏi WarehouseTransferItem (vật tư tiêu hao), theo
/// quyết định "không gộp" mục 7.5: 1 WarehouseTransfer chỉ chứa items HOẶC pieceItems, không cả
/// hai. Append-only, không update-in-place - cùng idiom TransferCheckResult, để "đã chuyển"
/// luôn tính được bằng SUM thay vì phải theo dõi state riêng.
model WarehouseTransferPieceItem {
  id                BigInt  @id @default(autoincrement())
  transferId        BigInt
  /// Đơn vị chuyển là (productionOrder, piece), không phải PI - xem mục 6 tài liệu trên (1 PI
  /// có thể gồm nhiều PO tiến độ khác nhau).
  productionOrderId BigInt
  pieceId           BigInt
  /// Đã clamp theo GetPieceTransferPlan (đã qua KCS trừ đã chuyển trước đó) tại thời điểm tạo
  /// phiếu - piece không có StockQuant làm nguồn khả dụng như vật tư nên clamp theo kế hoạch.
  quantity          Int
  note              String?

  transfer        WarehouseTransfer @relation(fields: [transferId], references: [id])
  productionOrder ProductionOrder   @relation(fields: [productionOrderId], references: [id])
  piece           Piece             @relation(fields: [pieceId], references: [id])

  @@index([transferId])
  @@index([productionOrderId, pieceId])
  @@map("warehouse_transfer_piece_items")
}

/// Giữ chỗ tồn kho khi phiếu đang PENDING, chặn 2 phiếu cùng lúc "double-book" cùng 1 phần
/// tồn kho khả dụng - RELEASED khi phiếu CONFIRMED/REJECTED (xem WarehouseTransfersService).
model WarehouseTransferReservation {
  id          BigInt            @id @default(autoincrement())
  transferId  BigInt
  warehouseId BigInt
  materialId  BigInt?
  quantity    Decimal           @db.Decimal(16, 4)
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())

  transfer  WarehouseTransfer @relation(fields: [transferId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  material  Material?         @relation(fields: [materialId], references: [id])

  @@index([warehouseId, materialId])
  @@map("warehouse_transfer_reservations")
}

// =====================================================================
// Phase 9 — MES-B: Steel Issue & QC Review (Phôi) — docs/dna-erp-db-schema.html mục 1.6,
// docs/dna-erp-backend-implementation-plan.html mục 9.1/9.2. Chỉ nhánh Phôi (steel_issue) ở
// bản này. QcReview/ReplenishRequest dùng chung cho cả 2 nhánh (productionBatchId để trống ở
// bản này, chỉ khai báo cột + FK cho tương lai - nhánh này mở ở Phase 9d bên dưới khi model
// ProductionBatch được thêm).
//
// Quyết định lệch tài liệu gốc (2026-08-11, xem roadmap M2): StockLedger (STEEL_ISSUE) đã
// được CuttingProposalsService.approve() ghi 1 lần gộp theo materialId ngay lúc duyệt phương
// án cắt (quyết định của Sếp 2026-08-07, sau ngày viết tài liệu gốc 2026-07-23) - SteelIssue
// ở đây CHỈ là lớp theo dõi thực thi vật lý, KHÔNG ghi thêm StockLedger nữa (double-count).
// =====================================================================

enum SteelIssueStatus {
  ISSUED
  RECEIVED
  /// Đã cắt (CAT) xong nhưng piece còn công đoạn khác (uốn/dập/...) trong processSteps chưa
  /// đánh dấu xong - xem SteelIssue.completedSteps, SteelIssuesService.completeStep().
  IN_PROCESS
  AWAITING_QC
  QC_PASSED
}

enum ReplenishRequestStatus {
  OPEN
  FULFILLED
  REJECTED
}

/// 1 đợt kho xuất sắt cho 1 (production_invoice, material) - gộp theo cả PI, không theo riêng 1
/// mảnh/PO (đổi từ productionOrderId+pieceId sang productionInvoiceId, xem changelog
/// 2026-08-18-xuat-sat-po-pi-vat-tu.md mục 2). Phôi tự phân bổ vật lý theo mảnh nào, hệ thống
/// không theo dõi - Phôi nhận rồi báo cắt xong (ghi CutBundle[] tại lúc đó, không phải lúc xuất -
/// Phôi có thể cắt lệch kiểu cắt đề xuất, xem CutBundle.proposalPatternId). Không có bảng "kế
/// hoạch xuất sắt" riêng - "cần xuất bao nhiêu" là query gộp theo material trên toàn PI trừ
/// SUM(SteelIssue gốc, loại reworkOfId != null).
///
/// LƯU Ý (2026-08-19): từ khi bỏ pieceId, KHÔNG còn cách nào đếm "đã xong bao nhiêu mảnh cụ thể"
/// từ SteelIssue - WarehouseTransfersService.getPieceTransferPlan() CHẶN CỨNG (throw) nếu gặp
/// mảnh needsHan=false ("vật tư thành phẩm", trước đây đếm qua SteelIssue.pieceId QC_PASSED) vì
/// thực tế nghiệp vụ hiện tại mọi mảnh đều needsHan=true (đã xác nhận với user) - xem comment ở
/// getPieceTransferPlan().
model SteelIssue {
  id                  BigInt           @id @default(autoincrement())
  productionInvoiceId BigInt
  /// Suy được từ CuttingProposalPattern đã APPROVED, giữ có kiểm soát vì là bất biến nghiệp vụ
  /// "1 đợt xuất = 1 loại sắt".
  materialId          BigInt
  barLengthMm         Int
  /// Số cây kho xuất đợt này. KHÔNG có trong tài liệu gốc (docs/dna-erp-db-schema.html thiếu
  /// field này ở steel_issue) - bổ sung vì mock (phoi-sat.service.ts xuatSatChoPhoi) và UI
  /// (XuatSatPage ô nhập số lượng) đều xác nhận đây là input bắt buộc, không phải hằng số 1.
  /// actualBarCount bên dưới "null = đúng như xuất" nghĩa là mặc định = giá trị này.
  barCount            Int
  status              SteelIssueStatus @default(ISSUED)
  /// Các công đoạn chi tiết (ProcessStep) đã đánh dấu xong của đợt này - luôn có CAT sau khi
  /// completeCutting(). So với union PieceBom.processSteps của piece (+ CAT mặc định) để biết đã
  /// đủ điều kiện chuyển AWAITING_QC chưa, xem SteelIssuesService.resolveRequiredSteps().
  completedSteps      ProcessStep[]    @default([])
  /// Client-supplied key cho POST /production-invoices/:id/steel-issues - resolve-or-return
  /// (cùng idiom CuttingProposal.idempotencyKey), chống tạo trùng đợt khi client gọi lại do
  /// timeout/mất mạng.
  idempotencyKey      String?          @unique
  /// Phôi báo thực cắt (complete-cutting) - null = đúng như xuất.
  actualBarCount      Int?
  issuedAt            DateTime         @default(now())
  issuedById          String
  /// Phôi xác nhận cắt xong.
  completedAt         DateTime?
  /// Self-reference - đợt làm lại do KCS bắt sửa (QcReview.failedQty > scrapQty).
  reworkOfId          BigInt?

  productionInvoice ProductionInvoice  @relation(fields: [productionInvoiceId], references: [id])
  material          Material           @relation(fields: [materialId], references: [id])
  issuedBy          User               @relation("SteelIssueIssuedBy", fields: [issuedById], references: [id])
  reworkOf          SteelIssue?        @relation("SteelIssueRework", fields: [reworkOfId], references: [id])
  reworkIssues      SteelIssue[]       @relation("SteelIssueRework")
  bundles           CutBundle[]
  qcReviews         QcReview[]
  replenishedBy     ReplenishRequest[] @relation("ReplenishRequestFulfilledByIssue")

  @@index([productionInvoiceId, materialId])
  @@index([status])
  @@map("steel_issues")
}

/// Các bó theo kiểu cắt THỰC TẾ của 1 đợt - ghi khi Phôi báo cắt xong (complete-cutting), chuẩn
/// hoá thành bảng con (không JSONB) để query/aggregate SQL trực tiếp theo cỡ đoạn. Immutable
/// sau khi tạo (output cắt của 1 đợt là dữ liệu lịch sử, không sửa lại).
model CutBundle {
  id                BigInt  @id @default(autoincrement())
  steelIssueId      BigInt
  /// NULL = cắt ngoài đề xuất (cho phép, nhưng cảnh báo isOffPlan ở response - không chặn cứng,
  /// nghiệp vụ vẫn cho Phôi linh hoạt).
  proposalPatternId BigInt?
  barCount          Int
  wastePerBarMm     Int?

  steelIssue      SteelIssue              @relation(fields: [steelIssueId], references: [id])
  proposalPattern CuttingProposalPattern? @relation(fields: [proposalPatternId], references: [id])
  segments        CutPatternSegment[]

  @@index([steelIssueId])
  @@map("cut_bundles")
}

/// 1 cây (theo bundle) ra những đoạn nào - immutable, đúng UNIQUE (cutBundleId, segmentSpecId)
/// giống cutting_proposal_pattern_segment.
model CutPatternSegment {
  id            BigInt @id @default(autoincrement())
  cutBundleId   BigInt
  segmentSpecId BigInt
  countPerBar   Int

  cutBundle   CutBundle   @relation(fields: [cutBundleId], references: [id])
  segmentSpec SegmentSpec @relation(fields: [segmentSpecId], references: [id])

  @@unique([cutBundleId, segmentSpecId])
  @@map("cut_pattern_segments")
}

/// KCS duyệt, dùng chung Phôi/Hàn/Sơn qua FK XOR (steelIssueId <> productionBatchId - CHECK
/// constraint viết tay trong migration, cùng pattern stock_ledger_goods_xor_chk). Chỉ nhánh
/// Phôi (steelIssueId) được dùng ở bản này - productionBatchId để trống, chờ hạng mục M2
/// "Sản lượng theo công đoạn" (bảng production_batch chưa tồn tại). KCS duyệt cả lô, không bóc
/// chi tiết theo cỡ đoạn - hỏng thì ghi số lượng + note. passed = SL gốc − failedQty là dẫn
/// xuất, không lưu cột riêng.
model QcReview {
  id                BigInt   @id @default(autoincrement())
  steelIssueId      BigInt?
  /// Nhánh Hàn/Sơn (Phase 9d, 2026-08-11) - XOR với steelIssueId, CHECK DB
  /// qc_reviews_goods_xor_chk đã áp từ Phase 9, chỉ thiếu FK thật tới nay.
  productionBatchId BigInt?
  failedQty         Int
  /// CHECK scrapQty <= failedQty (validate service, giống assertExactlyOneGoodsLeg style).
  scrapQty          Int?
  defectReasonId    BigInt?
  reason            String?
  photoUrl          String?
  reviewedAt        DateTime @default(now())
  reviewedById      String

  steelIssue        SteelIssue?        @relation(fields: [steelIssueId], references: [id])
  productionBatch   ProductionBatch?   @relation(fields: [productionBatchId], references: [id])
  defectReason      DefectReason?      @relation(fields: [defectReasonId], references: [id])
  reviewedBy        User               @relation("QcReviewReviewedBy", fields: [reviewedById], references: [id])
  replenishRequests ReplenishRequest[]

  @@index([steelIssueId])
  @@index([productionBatchId])
  @@map("qc_reviews")
}

/// Đề xuất cấp lại khi KCS chấm phế (QcReview.scrapQty > 0). fulfilledByIssueId chỉ áp dụng khi
/// qcReview thuộc Phôi (Hàn/Sơn: BLOCKED, dừng ở OPEN/REJECTED - xem tài liệu gốc mục 9.2,
/// "Hàn/Sơn cấp lại bán-thành-phẩm nghĩa là gì" chưa có quyết định nghiệp vụ).
model ReplenishRequest {
  id                 BigInt                 @id @default(autoincrement())
  qcReviewId         BigInt
  status             ReplenishRequestStatus @default(OPEN)
  /// Cho phép < scrapQty (cấp bù từng phần) - CHECK qty <= qcReview.scrapQty (validate service).
  qty                Int
  createdAt          DateTime               @default(now())
  fulfilledByIssueId BigInt?
  fulfilledAt        DateTime?
  fulfilledById      String?
  rejectionReason    String?

  qcReview         QcReview    @relation(fields: [qcReviewId], references: [id])
  fulfilledByIssue SteelIssue? @relation("ReplenishRequestFulfilledByIssue", fields: [fulfilledByIssueId], references: [id])
  fulfilledBy      User?       @relation("ReplenishRequestFulfilledBy", fields: [fulfilledById], references: [id])

  @@index([status])
  @@map("replenish_requests")
}

// =====================================================================
// Phase 9b — Đan (weaving points), M2 ưu tiên 1 (2026-08-11, xem roadmap docs/dna-erp-roadmap.html
// mục 08). Thay manh.service.ts mock: kho vật tư-TP ("vat-tu-tp") xuất khung cho 1 điểm đan
// ngoài ("xuất đan"), điểm đan trả lại hàng đã đan xong ("nhập đan"). Cả 2 đều append-only,
// KHÔNG có state machine (khác SteelIssue) - mọi vi phạm nghiệp vụ là lỗi 400 (validate số
// lượng), không phải 409 (không có transition trạng thái nào để xung đột).
//
// KHÔNG ghi StockLedger, cùng lý do SteelIssue không ghi: domain "Sản lượng theo công đoạn
// Phôi/Hàn/Sơn" (nguồn tồn khung thật) chưa được xây (M2 riêng) - đây chỉ là lớp theo dõi thực
// thi thuần, cap số lượng bằng định mức BOM (bomPiece.qtyPerUnit × productionOrder.quantity),
// giống hệt idiom SteelIssuesService.getIssuePlan().
// =====================================================================

/// 1 đợt kho vật tư-TP xuất khung cho 1 điểm đan, theo (production_order, piece, weaving_point).
/// Không link 1-1 tới đợt "nhập" cụ thể - WeavingReceipt cap theo tổng luỹ kế
/// (SUM issued - SUM received) của đúng 3 khoá này, mirror allocation.xuatQty của mock
/// (manh.service.ts). "Còn xuất được bao nhiêu" = định mức BOM trừ SUM(WeavingIssue.qty) MỌI
/// điểm đan cho (production_order, piece) - xem WeavingIssuesService.getIssuePlan().
model WeavingIssue {
  id                BigInt   @id @default(autoincrement())
  productionOrderId BigInt
  pieceId           BigInt
  weavingPointId    BigInt
  qty               Int
  /// Client-supplied key cho POST production-orders/:id/weaving-issues - resolve-or-return,
  /// cùng idiom SteelIssue.idempotencyKey.
  idempotencyKey    String?  @unique
  issuedAt          DateTime @default(now())
  issuedById        String

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  piece           Piece           @relation(fields: [pieceId], references: [id])
  weavingPoint    WeavingPoint    @relation(fields: [weavingPointId], references: [id])
  issuedBy        User            @relation("WeavingIssueIssuedBy", fields: [issuedById], references: [id])

  @@index([productionOrderId, pieceId, weavingPointId])
  @@map("weaving_issues")
}

/// 1 đợt nhận khung đã đan xong về từ 1 điểm đan cụ thể. Không link tới 1 WeavingIssue cụ thể -
/// mirror nhapManh() ở mock (clamp theo tổng luỹ kế của allocation, không chọn batch). Đây là
/// nguồn dữ liệu THẬT cho TransferCheckPieceResponseDto.readyQty (trước đây hardcode 0) - xem
/// ProductionInvoicesService.listTransferCheckPieces().
model WeavingReceipt {
  id                BigInt   @id @default(autoincrement())
  productionOrderId BigInt
  pieceId           BigInt
  weavingPointId    BigInt
  qty               Int
  /// Bắt buộc có cột riêng (không dùng chung WeavingIssue.idempotencyKey) - create() thuần,
  /// không có state machine để tự chống trùng như SteelIssue.receive() (update trạng thái),
  /// thiếu key sẽ double-count khi client retry.
  idempotencyKey    String?  @unique
  receivedAt        DateTime @default(now())
  receivedById      String

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  piece           Piece           @relation(fields: [pieceId], references: [id])
  weavingPoint    WeavingPoint    @relation(fields: [weavingPointId], references: [id])
  receivedBy      User            @relation("WeavingReceiptReceivedBy", fields: [receivedById], references: [id])

  @@index([productionOrderId, pieceId, weavingPointId])
  @@map("weaving_receipts")
}

// =====================================================================
// Phase 9c — Material Issue (M2 "Xuất vật tư tiêu hao" Hàn/Sơn, 2026-08-11, xem roadmap docs/
// dna-erp-roadmap.html mục 08). Thay vat-tu-noi-bo.service.ts mock: kho vật tư-TP ("vat-tu-tp")
// xuất vật tư tiêu hao (CO₂, dây hàn, bột sơn, dung môi...) cho tổ Hàn/Sơn, tổ xác nhận đã nhận.
// Tách khỏi production_batch/work_session (docs/dna-erp-backend-implementation-plan.html mục
// 9.3 gộp cả 3 vào 1 hạng mục, nhưng CreateMaterialIssueDto gốc không phụ thuộc
// productionBatchId - implement riêng material_issue trước, production_batch/work_session vẫn
// thuộc hạng mục M2 "Sản lượng theo công đoạn" khác, chưa triển khai).
//
// KHÁC steel_issue/weaving_issue: CÓ ghi StockLedger (ref_type=MATERIAL_ISSUE - enum đã tồn tại
// từ Phase 3 nhưng chưa module nào dùng tới nay). Vật tư tiêu hao chưa bị trừ tồn ở bước nào
// trước đó (khác sắt: CuttingProposal.approve() đã trừ tồn ngay lúc duyệt phương án cắt) - đây
// là điểm trừ tồn DUY NHẤT của dòng vật tư này, đúng thiết kế gốc "kho vật tư → PRODUCTION (ảo)"
// (dna-erp-db-schema.html mục 4, luồng phân phối nội bộ). fromWarehouse cố định 'vat-tu-tp'
// (đúng ghi chú SEED_WAREHOUSES "Sơn, dây, vật tư tiêu hao sản xuất"), toWarehouse cố định
// 'PRODUCTION' (ảo, không có tồn vật lý).
// =====================================================================

enum MaterialIssueStatus {
  ISSUED
  RECEIVED
}

/// Phiếu cấp vật tư tiêu hao nội bộ Hàn/Sơn (CO₂, dây hàn, bột sơn, dung môi...) - khác WIP
/// (đoạn/khung), append-only theo (production_order, stage, material), chỉ ISSUED -> RECEIVED
/// (không có AWAITING_QC - vật tư tiêu hao không qua KCS, khác SteelIssue). Định mức nằm ở
/// ConsumableBom (theo bomRevision của PO), bảng này chỉ là sự kiện xuất/nhận - đúng
/// docs/dna-erp-db-schema.html mục "material_issue" ("Định mức đã chuyển vào consumable_bom -
/// bảng này chỉ còn là sự kiện xuất/nhận").
model MaterialIssue {
  id                BigInt              @id @default(autoincrement())
  stage             MfgStage
  productionOrderId BigInt
  materialId        BigInt
  issuedQty         Decimal             @db.Decimal(14, 4)
  status            MaterialIssueStatus @default(ISSUED)
  /// Client-supplied key cho POST /production-orders/:id/material-issues - resolve-or-return,
  /// cùng idiom SteelIssue.idempotencyKey/WeavingIssue.idempotencyKey. KHÔNG có trong bảng cột
  /// gốc ở dna-erp-db-schema.html mục "material_issue" nhưng dna-erp-backend-implementation-
  /// plan.html mục 9.3 yêu cầu header Idempotency-Key bắt buộc cho endpoint tạo - bổ sung cột
  /// để lưu, cùng lý do các model Phase 9/9b đã bổ sung so với tài liệu gốc.
  idempotencyKey    String?             @unique
  issuedAt          DateTime            @default(now())
  issuedById        String
  /// Tổ xác nhận nhận - nhận thiếu thì < issuedQty; null = đủ như xuất.
  receivedQty       Decimal?            @db.Decimal(14, 4)
  receivedAt        DateTime?
  receivedById      String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  material        Material        @relation(fields: [materialId], references: [id])
  issuedBy        User            @relation("MaterialIssueIssuedBy", fields: [issuedById], references: [id])
  receivedBy      User?           @relation("MaterialIssueReceivedBy", fields: [receivedById], references: [id])

  @@index([productionOrderId, stage, materialId])
  @@index([status])
  @@map("material_issues")
}

// =====================================================================
// Phase 9d — Sản lượng theo công đoạn Hàn/Sơn (M2, 2026-08-11, xem roadmap docs/
// dna-erp-roadmap.html mục 08) - thay san-luong.service.ts mock. Mở nhánh productionBatchId
// của QcReview/ReplenishRequest đã có sẵn XOR + CHECK DB (qc_reviews_goods_xor_chk) từ Phase 9,
// chỉ thiếu FK thật tới nay (xem comment cũ ở QcReview.productionBatchId).
//
// Lệch tài liệu gốc (dna-erp-backend-implementation-plan.html mục 9.3): KHÔNG triển khai
// WorkSession ở đợt này - mock (san-luong.service.ts, LenhSanXuatHan.tsx/LenhSanXuatSon.tsx)
// không có khái niệm "ca làm việc" nào để validate qua UI, khác ProductionBatch/QcReview (map
// 1-1 rõ với baoSanLuong()/kcsDuyetStage() đã chạy qua UI thật). Xây WorkSession lúc này sẽ là
// suy đoán API không có gì kiểm chứng - đúng nguyên tắc "chỉ theo hành vi mock đã validate" đã
// áp dụng nhất quán ở steel_issue/weaving_issue/material_issue.
//
// KHÔNG ghi StockLedger (SEGMENT_CONSUME/FRAME_OUTPUT theo mermaid diagram gốc dna-erp-db-schema.
// html mục 0) - 2 ref_type này chưa từng được dùng ở đâu (SteelIssue không ghi segment_spec_id
// vào ledger khi cắt xong; CutBundle/CutPatternSegment chỉ là bảng theo dõi cắt, không phải tồn
// kho thật) - SEGMENT_CONSUME sẽ trừ vào 1 số dư chưa từng được cộng. Cùng lý do steel_issue/
// weaving_issue quyết định không ghi ledger - ProductionBatch/QcReview chỉ là lớp theo dõi thực
// thi thuần ở đợt này.
// =====================================================================

enum ProductionBatchStatus {
  AWAITING_QC
  QC_DONE
}

/// Lô báo sản lượng Hàn/Sơn - công nhân báo, KCS duyệt qua QcReview nhánh productionBatchId
/// (QcReviewsService.reviewProductionBatch()). Khác SteelIssue: KHÔNG có endpoint tạo lô rework
/// riêng (xem comment section ở trên) - phần sửa được (rework) không tính done, tự "hiện lại" ở
/// lần báo tiếp theo, đúng hành vi mock kcsDuyetStage(). reportedQty không cap theo BOM lúc báo
/// (mock baoSanLuong() không kiểm tra - QC là bước kiểm soát chất lượng, không phải định mức).
model ProductionBatch {
  id                BigInt                @id @default(autoincrement())
  stage             MfgStage
  productionOrderId BigInt
  /// Hàn/Sơn báo sản lượng theo MẢNH (Piece) - khớp Phôi (SteelIssue.pieceId) và Đan
  /// (WeavingIssue/WeavingReceipt.pieceId), vì Hàn -> Sơn -> Đan đều làm việc theo mảnh. Trước
  /// đây gắn Part (chi tiết) - đổi hẳn sang Piece, không phải thêm trục song song.
  pieceId           BigInt
  /// Công nhân báo lúc tạo; QcReviewsService.reviewProductionBatch() ghi đè lại = phần ĐẠT
  /// (passed) sau khi KCS duyệt - đúng hành vi mock (b.qty = passed, "done chỉ tính phần đạt").
  reportedQty       Int
  status            ProductionBatchStatus @default(AWAITING_QC)
  /// Client-supplied key cho POST /production-orders/:id/production-batches - resolve-or-return,
  /// cùng idiom SteelIssue.idempotencyKey/MaterialIssue.idempotencyKey. KHÔNG có trong bảng cột
  /// gốc (dna-erp-db-schema.html mục "production_batch" thiếu cột này) nhưng
  /// dna-erp-backend-implementation-plan.html mục 9.3 yêu cầu header Idempotency-Key bắt buộc.
  idempotencyKey    String?               @unique
  reportedAt        DateTime              @default(now())
  reportedById      String
  /// Giữ cột theo tài liệu gốc nhưng KHÔNG có API set giá trị này ở đợt này (xem comment section
  /// đầu - "Mock hiện KHÔNG tạo lô rework mới cho Hàn/Sơn").
  reworkOfId        BigInt?

  productionOrder ProductionOrder   @relation(fields: [productionOrderId], references: [id])
  piece           Piece             @relation(fields: [pieceId], references: [id])
  reportedBy      User              @relation("ProductionBatchReportedBy", fields: [reportedById], references: [id])
  reworkOf        ProductionBatch?  @relation("ProductionBatchRework", fields: [reworkOfId], references: [id])
  reworkBatches   ProductionBatch[] @relation("ProductionBatchRework")
  qcReviews       QcReview[]

  @@index([productionOrderId, pieceId])
  @@index([stage, status])
  @@map("production_batches")
}
